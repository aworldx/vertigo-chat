API_PUBLIC_ORIGIN=https://chat.example.com
# Exact trusted Caddy peer CIDR(s), comma separated. Empty trusts no proxy.
# Set from the production Docker network; never trust all addresses.
API_TRUSTED_PROXY_CIDRS=
CADDY_SITE_ADDRESS=chat.example.com
# Long random value used by Prometheus in Authorization: Bearer <value>.
# Keep it only on the VPS, never in a dashboard URL or browser configuration.
METRICS_TOKEN=replace-with-a-long-random-token
# File containing exactly the same token, for Prometheus in the private Docker network.
METRICS_TOKEN_FILE=/opt/apps/vertigo-chat/.metrics_token
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-second-long-random-password

POSTGRES_DB=chat_prod
POSTGRES_USER=chat
POSTGRES_PASSWORD='replace-with-a-url-safe-password'

OPENAI_API_KEY=sk-replace-me
OPENAI_BOT_MODEL=gpt-5.6-terra
OPENAI_BOT_RECEIVE_TIMEOUT_MS=120000
OPENAI_BOT_DAILY_TOKEN_LIMIT=120000
OPENAI_BOT_TOKEN_WARNING_PERCENT=90
OPENAI_BOT_UTC_OFFSET_MINUTES=180

# Session reconnect grace periods in seconds. Hidden mobile tabs get a longer
# interval because Safari may freeze their WebSocket while the app is backgrounded.
CHAT_SESSION_GRACE_SECONDS=60
CHAT_HIDDEN_SESSION_GRACE_SECONDS=300

# Optional GitLab Container Registry access on production. It is unnecessary
# for a public image. For a private image, use a GitLab deploy token with only
# read_registry and keep its values only in the VPS .env file.
GITLAB_REGISTRY_USERNAME=
GITLAB_REGISTRY_TOKEN=

# Optional authenticated HTTP proxies for music search. The file is not tracked
# and contains one host:port:username:password entry per line.
# Local development: MUSIC_PROXY_FILE=$PWD/music-proxies.txt (ignored by Git).
MUSIC_PROXY_FILE=/opt/apps/vertigo-chat/music-proxies.txt

# YouTube video preparation runs in a separate, resource-limited container.
# Keep one active preparation so other videos wait in its FIFO queue.
YOUTUBE_CACHE_MAX_PREPARATIONS=1
YOUTUBE_WORKER_MEM_LIMIT=768m
YOUTUBE_WORKER_CPUS=1.0

# S3 media storage; enable only after checking bucket access.
S3_ENABLED=false
S3_ENDPOINT=https://s3.kz-1.srvstorage.kz
S3_REGION=kz-1
S3_BUCKET=vertigo
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
# Set to true when the bucket uses Selectel vHosted addressing (required for browser CORS uploads).
S3_VIRTUAL_HOSTED=false

# Optional organization Costs API monitoring (separate admin key, never the bot key).
OPENAI_COSTS_ADMIN_KEY=
OPENAI_COSTS_ORGANIZATION_ID=
