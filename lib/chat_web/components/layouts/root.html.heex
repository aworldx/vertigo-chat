<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Vertigo chat" suffix=" · Vertigo chat" phx-no-format>{assigns[:page_title]}</.live_title>
    <meta
      name="description"
      content={assigns[:meta_description] || "Vertigo — чат для общения, новых знакомств и игр."}
    />
    <meta name="robots" content={assigns[:robots] || "index, follow"} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Vertigo" />
    <meta property="og:type" content={assigns[:og_type] || "website"} />
    <meta
      property="og:title"
      content={assigns[:og_title] || assigns[:page_title] || "Vertigo chat"}
    />
    <meta
      property="og:description"
      content={assigns[:meta_description] || "Vertigo — чат для общения, новых знакомств и игр."}
    />
    <%= if canonical_path = assigns[:canonical_path] do %>
      <link rel="canonical" href={ChatWeb.Endpoint.url() <> canonical_path} />
      <meta property="og:url" content={ChatWeb.Endpoint.url() <> canonical_path} />
    <% end %>
    <link
      rel="preload"
      href={~p"/fonts/oswald-variable.ttf"}
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link
      rel="preload"
      href={~p"/fonts/manrope-variable.ttf"}
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script
      :if={!assigns[:disable_live_socket]}
      defer
      phx-track-static
      type="text/javascript"
      src={~p"/assets/js/app.js"}
    >
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
