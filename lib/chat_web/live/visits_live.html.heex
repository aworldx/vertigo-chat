<Layouts.app flash={@flash}>
  <section
    id="visits-page"
    class="chat-shell min-h-screen bg-zinc-950 text-zinc-100"
    data-chat-theme="vertigo"
    data-chat-mode="dark"
  >
    <header class="flex min-h-16 items-center justify-between border-b border-zinc-800 bg-zinc-900 px-4 sm:px-8">
      <a href={~p"/"} target="vertigo-chat" data-return-to-chat class="flex items-center gap-3">
        <span class="vertigo-mark" aria-hidden="true"></span>
        <span class="vertigo-wordmark uppercase">Vertigo</span>
      </a>
      <.link
        href={~p"/"}
        target="vertigo-chat"
        data-return-to-chat
        class="flex items-center gap-2 text-sm text-zinc-300 transition hover:text-amber-300"
      >
        <.icon name="hero-arrow-left" class="size-4" /> Вернуться в чат
      </.link>
    </header>

    <main class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-8">
      <div class="border-b border-zinc-800 pb-8">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-rose-300">
          История присутствия
        </p>
        <h1 class="mt-2 text-4xl font-semibold sm:text-5xl">Кто был</h1>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-zinc-400">
          Входы и выходы чатлан за последние {@history_hours} часов. Время указано по Москве.
        </p>
      </div>

      <div class="mt-8 overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900/70 shadow-2xl">
        <div class="overflow-x-auto">
          <table class="w-full min-w-[42rem] border-collapse text-left">
            <thead class="border-b border-zinc-700 bg-zinc-900 text-xs uppercase tracking-[0.16em] text-zinc-500">
              <tr>
                <th scope="col" class="px-5 py-4 font-medium sm:px-7">Ник</th>
                <th scope="col" class="px-5 py-4 font-medium sm:px-7">Дата входа</th>
                <th scope="col" class="hidden px-5 py-4 font-medium sm:table-cell sm:px-7">
                  Дата выхода
                </th>
              </tr>
            </thead>
            <tbody id="visits" phx-update="stream" class="divide-y divide-zinc-800">
              <tr id="visits-empty" class="hidden only:table-row">
                <td colspan="3" class="px-6 py-16 text-center text-sm text-zinc-500">
                  За последние двое суток входов пока не было.
                </td>
              </tr>
              <tr
                :for={{dom_id, visit} <- @streams.visits}
                id={dom_id}
                data-visit-nickname={visit.nickname}
                class="transition hover:bg-white/[0.03]"
              >
                <td class="px-5 py-4 sm:px-7">
                  <span class="chat-user-nickname text-lg text-amber-200">{visit.nickname}</span>
                </td>
                <td class="px-5 py-4 text-sm text-zinc-300 sm:px-7">
                  {format_datetime(visit.entered_at)}
                  <p class="mt-1 text-xs text-zinc-500 sm:hidden">
                    <%= if visit.left_at do %>
                      Вышел: {format_datetime(visit.left_at)}
                    <% else %>
                      <span class="inline-flex items-center gap-1.5 text-emerald-300">
                        <span class="size-1.5 rounded-full bg-emerald-400"></span> Сейчас в чате
                      </span>
                    <% end %>
                  </p>
                </td>
                <td class="hidden whitespace-nowrap px-5 py-4 text-sm sm:table-cell sm:px-7">
                  <%= if visit.left_at do %>
                    <span class="text-zinc-300">{format_datetime(visit.left_at)}</span>
                  <% else %>
                    <span class="inline-flex items-center gap-2 text-emerald-300">
                      <span class="size-2 rounded-full bg-emerald-400 shadow-[0_0_0.75rem_rgba(52,211,153,0.45)]"></span>
                      Сейчас в чате
                    </span>
                  <% end %>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </section>
</Layouts.app>
