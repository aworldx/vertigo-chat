<Layouts.app flash={@flash}>
  <div
    id="games-page"
    phx-hook=".GamesAuth"
    class={"games-page games-page--#{@kind || "catalog"} min-h-screen bg-zinc-950 px-4 py-8 text-zinc-100"}
  >
    <div class="mx-auto max-w-6xl">
      <header class="mb-8 flex flex-wrap items-center justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.3em] text-amber-400">
            Vertigo games
          </p><h1 class="mt-1 text-4xl font-black tracking-tight">
            {if @kind, do: title(@kind), else: "Игры для чатлан"}
          </h1>
        </div>
        <.link
          href={~p"/"}
          id="games-back-to-chat"
          class="rounded-full border border-zinc-700 px-4 py-2 text-sm hover:border-amber-400"
        >Вернуться в чат</.link>
      </header>

      <%= if is_nil(@kind) do %>
        <section id="games-catalog" class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
          <.link
            :for={{kind, info} <- kinds()}
            id={"game-card-#{kind}"}
            navigate={~p"/games/#{kind}"}
            class={"game-catalog-card game-catalog-card--#{kind} rounded-3xl border border-zinc-800 bg-zinc-900 p-6 transition hover:-translate-y-1 hover:border-amber-400"}
          >
            <span class="game-catalog-card__art" aria-hidden="true"></span>
            <h2 class="text-2xl font-bold">{info.title}</h2><p class="mt-2 text-sm text-zinc-400">
              {if kind == "battleship",
                do: "Потопи флот соперника",
                else:
                  if(kind == "durak",
                    do: "Карты для 2–4 игроков",
                    else: "Составляй слова на общем поле"
                  )}
            </p><span class="mt-5 inline-block text-amber-300">Открыть →</span>
          </.link>
          <.link
            id="game-card-checkers"
            href={~p"/checkers"}
            class="game-catalog-card game-catalog-card--checkers rounded-3xl border border-zinc-800 bg-zinc-900 p-6 transition hover:-translate-y-1 hover:border-amber-400"
          ><span class="game-catalog-card__art" aria-hidden="true"></span><h2 class="text-2xl font-bold">
            Шашки
          </h2><p class="mt-2 text-sm text-zinc-400">
            Классическая партия на двоих
          </p><span class="mt-5 inline-block text-amber-300">Открыть →</span></.link>
        </section>
      <% else %>
        <%= cond do %>
          <% !@auth_checked? -> %>
            <p
              id="games-auth-check"
              class="rounded-2xl border border-zinc-800 bg-zinc-900 p-6 text-zinc-400"
            >
              Проверяем вход…
            </p>
          <% is_nil(@current_user) -> %>
            <div
              id="games-login-hint"
              class="rounded-2xl border border-amber-500/30 bg-amber-950/20 p-8 text-center"
            >
              <h2 class="text-2xl font-bold">Сначала войди в чат</h2><p class="mt-2 text-zinc-400">
                Играть могут зарегистрированные чатлане.
              </p>
            </div>
          <% true -> %>
            <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_19rem]">
              <main class="space-y-6">
                <section
                  id="games-lobby"
                  class="rounded-3xl border border-zinc-800 bg-zinc-900/80 p-5"
                >
                  <div class="flex flex-wrap items-center justify-between gap-3">
                    <div>
                      <h2 class="text-xl font-bold">Игровая</h2><p class="text-sm text-zinc-400">
                        Ты вошёл как
                        <span class="text-amber-300">{display_name(@current_user)}</span>
                      </p>
                    </div><button
                      id="create-game"
                      phx-click="create"
                      class="rounded-xl bg-amber-400 px-4 py-2 font-bold text-zinc-950"
                    >Создать стол</button>
                  </div>
                  <div id="my-games" class="mt-5 grid gap-3 sm:grid-cols-2">
                    <p :if={@games == []} id="games-empty" class="text-sm text-zinc-500">
                      Твоих открытых столов пока нет.
                    </p><article
                      :for={game <- @games}
                      id={"game-#{game.id}"}
                      class="rounded-2xl border border-zinc-700 bg-zinc-950/60 p-4"
                    >
                      <strong>{Enum.map_join(game.players, " · ", &display_name(&1.user))}</strong><p class="mt-1 text-sm text-zinc-500">
                        {if game.status == "waiting", do: "Набираем игроков", else: "Идёт партия"} · {length(
                          game.players
                        )}/{Games.max_players(@kind)}
                      </p><button
                        id={"open-game-#{game.id}"}
                        phx-click="open"
                        phx-value-id={game.id}
                        class="mt-3 text-sm font-semibold text-amber-300"
                      >Открыть →</button><button
                        :if={can_start?(game, @current_user)}
                        id={"start-game-#{game.id}"}
                        phx-click="start"
                        phx-value-id={game.id}
                        class="ml-3 mt-3 text-sm font-semibold text-emerald-300"
                      >Начать</button>
                    </article>
                  </div>
                  <div
                    :if={@waiting_games != []}
                    id="waiting-games"
                    class="mt-6 border-t border-zinc-800 pt-5"
                  >
                    <h3 class="font-bold">Свободные столы</h3>
                    <div class="mt-3 grid gap-3 sm:grid-cols-2">
                      <article
                        :for={game <- @waiting_games}
                        id={"waiting-game-#{game.id}"}
                        class="rounded-2xl border border-zinc-700 bg-zinc-950/60 p-4"
                      >
                        <strong>{display_name(game.creator)}</strong>
                        <p class="mt-1 text-sm text-zinc-500">
                          Игроков: {length(game.players)}/{Games.max_players(@kind)}
                        </p>
                        <button
                          id={"join-game-#{game.id}"}
                          phx-click="join"
                          phx-value-id={game.id}
                          class="mt-3 text-sm font-semibold text-emerald-300"
                        >Присоединиться</button>
                      </article>
                    </div>
                  </div>
                  <div
                    :if={@active_games != []}
                    id="spectator-games"
                    class="mt-6 border-t border-zinc-800 pt-5"
                  >
                    <h3 class="font-bold">Сейчас играют</h3><p class="mt-1 text-sm text-zinc-500">
                      Можно наблюдать за активными партиями.
                    </p><article
                      :for={game <- @active_games}
                      id={"spectator-game-#{game.id}"}
                      class="mt-3 rounded-2xl border border-zinc-700 bg-zinc-950/60 p-4"
                    >
                      <strong>{Enum.map_join(game.players, " — ", &display_name(&1.user))}</strong><button
                        id={"watch-game-#{game.id}"}
                        phx-click="open"
                        phx-value-id={game.id}
                        class="ml-3 text-sm font-semibold text-amber-300"
                      >Смотреть →</button>
                    </article>
                  </div>
                </section>

                <section
                  :if={@game}
                  id="active-game"
                  class="rounded-3xl border border-zinc-800 bg-zinc-900 p-5"
                >
                  <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
                    <div>
                      <h2 class="text-xl font-bold">
                        {Enum.map_join(@game.players, " — ", &display_name(&1.user))}
                      </h2><p id="game-status" class="text-sm text-zinc-400">
                        {if @game.status == "finished",
                          do: "Партия завершена",
                          else:
                            if(player?(@game, @current_user),
                              do: "Ты за столом",
                              else: "Режим зрителя"
                            )}
                      </p>
                    </div><span
                      :if={@game.winner}
                      id="game-winner"
                      class="rounded-full bg-amber-400 px-3 py-1 text-xs font-bold text-zinc-950"
                    >Победитель: {display_name(@game.winner)}</span>
                  </div>
                  <div
                    :if={@game.status == "finished"}
                    id="game-result"
                    class={"game-result game-result--#{game_result_kind(@game, @current_user)}"}
                  >
                    <span class="game-result__mark" aria-hidden="true">
                      {if game_result_kind(@game, @current_user) == "victory", do: "★", else: "♟"}
                    </span>
                    <h3>{game_result_title(@game, @current_user)}</h3>
                    <p>{game_result_text(@game, @current_user)}</p>
                    <button
                      id="return-to-games-lobby"
                      type="button"
                      phx-click="return_to_games_lobby"
                      class="game-result__action"
                    >Вернуться в игровую</button>
                  </div>
                  <div :if={@game.status != "finished" and @game.kind == "battleship"}>
                    <p
                      :if={@game.status == "waiting" and !battleship_setup_open?(@game)}
                      id="battleship-awaiting-start"
                      class="text-sm text-zinc-400"
                    >
                      {if length(@game.players) < Games.max_players(@game.kind),
                        do:
                          "Ждём второго игрока. Расстановка откроется, когда партия будет начата.",
                        else:
                          "Создатель стола должен нажать «Начать», после этого можно расставлять флот."}
                    </p>
                    <div
                      :if={battleship_setup_open?(@game) and player?(@game, @current_user)}
                      id="fleet-setup"
                    >
                      <p class="mb-3 text-sm text-zinc-400">
                        Расставь корабли сам: выбери размер и направление, затем кликни по началу
                        корабля. Корабли не могут касаться друг друга.
                      </p>
                      <div id="fleet-controls" class="mb-3 flex flex-wrap items-center gap-2">
                        <button
                          :for={size <- [4, 3, 2, 1]}
                          id={"fleet-size-#{size}"}
                          type="button"
                          phx-click="select_fleet_size"
                          phx-value-size={size}
                          disabled={fleet_remaining(@fleet_draft, size) == 0}
                          class={[
                            "rounded-lg border px-3 py-2 text-sm font-bold transition",
                            @fleet_size == size && "border-amber-300 bg-amber-300 text-zinc-950",
                            @fleet_size != size &&
                              "border-zinc-600 text-zinc-200 hover:border-amber-300",
                            fleet_remaining(@fleet_draft, size) == 0 &&
                              "cursor-not-allowed opacity-40"
                          ]}
                        >
                          {ship_type_label(size)} · {size} палубы × {fleet_remaining(
                            @fleet_draft,
                            size
                          )}
                        </button>
                        <button
                          id="toggle-fleet-orientation"
                          type="button"
                          phx-click="toggle_fleet_orientation"
                          class="rounded-lg border border-zinc-600 px-3 py-2 text-sm text-zinc-200 transition hover:border-amber-300"
                        >
                          {if @fleet_orientation == "horizontal",
                            do: "Горизонтально ↔",
                            else: "Вертикально ↕"}
                        </button>
                      </div>
                      <div
                        id="battleship-fleet-board"
                        class="grid max-w-md grid-cols-10 overflow-hidden rounded border border-zinc-700"
                      >
                        <button
                          :for={{row, col, square} <- squares(10)}
                          id={"fleet-cell-#{row}-#{col}"}
                          type="button"
                          phx-click={
                            if MapSet.member?(fleet_draft_cells(@fleet_draft), square),
                              do: "remove_fleet_ship",
                              else: "place_fleet_ship"
                          }
                          phx-value-square={square}
                          class={[
                            "battleship-cell battleship-fleet-cell aspect-square border border-zinc-800",
                            MapSet.member?(fleet_draft_cells(@fleet_draft), square) &&
                              "battleship-cell--ship"
                          ]}
                          aria-label={
                            if MapSet.member?(fleet_draft_cells(@fleet_draft), square),
                              do: "Убрать корабль",
                              else: "Поставить корабль"
                          }
                        >
                          <.ship_model
                            :if={ship_model(@fleet_draft, square)}
                            model={ship_model(@fleet_draft, square)}
                          />
                        </button>
                      </div>
                      <p id="fleet-progress" class="mt-3 text-sm text-zinc-400">
                        Расставлено кораблей: {length(@fleet_draft)}/{length(
                          Games.fleet_lengths()
                        )}.
                      </p>
                      <div class="mt-3 flex flex-wrap gap-3">
                        <button
                          id="confirm-fleet"
                          type="button"
                          phx-click="confirm_fleet"
                          disabled={!fleet_complete?(@fleet_draft)}
                          class="rounded-xl bg-emerald-400 px-4 py-2 font-bold text-zinc-950 disabled:cursor-not-allowed disabled:opacity-40"
                        >Подтвердить флот</button><button
                          :if={!fleet_ready?(@game, @current_user)}
                          id="place-fleet"
                          type="button"
                          phx-click="fleet"
                          phx-value-id={@game.id}
                          class="rounded-xl border border-amber-300 px-4 py-2 font-bold text-amber-200"
                        >Расставить автоматически</button>
                      </div><p
                        :if={fleet_ready?(@game, @current_user)}
                        class="mt-3 text-emerald-300"
                      >
                        Твой флот готов. Ждём соперника.
                      </p>
                    </div><div
                      :if={@game.status in ["active", "finished"]}
                      class="grid gap-6 md:grid-cols-2"
                    >
                      <p id="battleship-turn" class="md:col-span-2 text-sm text-zinc-300">
                        {cond do
                          @game.status == "finished" ->
                            "Партия завершена."

                          current_turn?(@game, @current_user) ->
                            "Твой ход — выбери клетку на поле соперника. После попадания стреляй ещё."

                          true ->
                            "Сейчас ходит " <> player_name(@game, @game.state["turn_id"]) <> "."
                        end}
                      </p>
                      <div>
                        <h3 class="mb-2 font-bold">Твой флот</h3><div
                          id="battleship-own-board"
                          class="grid grid-cols-10 overflow-hidden rounded border border-zinc-700"
                        >
                          <span
                            :for={{row, col, square} <- squares(10)}
                            class={[
                              "battleship-cell grid aspect-square place-items-center border border-zinc-800 text-[9px]",
                              own_board(@game, @current_user)[square] == "ship" &&
                                "battleship-cell--ship",
                              received_shots(@game)[square] == "hit" &&
                                "battleship-cell--hit",
                              square in sunk_cells(@game, "own") && "battleship-cell--sunk"
                            ]}
                            aria-label={
                              if square in sunk_cells(@game, "own"), do: "Потопленный корабль"
                            }
                          ><.ship_model
                            :if={
                              ship_model(
                                get_in(@game.state, ["fleets", user_key(@current_user)]) || %{},
                                square
                              )
                            }
                            model={
                              ship_model(
                                get_in(@game.state, ["fleets", user_key(@current_user)]) || %{},
                                square
                              )
                            }
                          /></span>
                        </div>
                      </div><div>
                        <h3 class="mb-1 font-bold">Выстрелы</h3>
                        <p id="battleship-sunk-status" class="mb-2 text-xs text-zinc-400">
                          Полностью потопленные корабли отмечены жёлтым крестом.
                        </p><div
                          id="battleship-target-board"
                          class="grid grid-cols-10 overflow-hidden rounded border border-zinc-700"
                        >
                          <button
                            :for={{row, col, square} <- squares(10)}
                            id={"shot-#{row}-#{col}"}
                            disabled={
                              !current_turn?(@game, @current_user) or
                                !player?(@game, @current_user) or @game.status == "finished"
                            }
                            phx-click="shot"
                            phx-value-square={square}
                            data-game-sound="shot"
                            class={[
                              "battleship-cell battleship-target-cell aspect-square border border-zinc-800 text-[9px]",
                              own_shots(@game, @current_user)[square] == "hit" &&
                                "battleship-cell--hit",
                              own_shots(@game, @current_user)[square] == "miss" &&
                                "battleship-cell--miss",
                              square in sunk_cells(@game, "target") && "battleship-cell--sunk"
                            ]}
                            aria-label={
                              if square in sunk_cells(@game, "target"), do: "Потопленный корабль"
                            }
                          >{if own_shots(@game, @current_user)[square] == "hit",
                            do: "×",
                            else: if(own_shots(@game, @current_user)[square] == "miss", do: "·")}</button>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div :if={@game.status != "finished" and @game.kind == "durak"}>
                    <p id="durak-turn" class="mb-3 text-sm text-zinc-400">
                      {durak_turn_message(@game, @current_user)} · козырь {card_suit(
                        @game.state["trump"] || "6-♠"
                      )}
                    </p><div
                      id="durak-table"
                      class="min-h-24 rounded-2xl border border-dashed border-zinc-700 p-4"
                    >
                      <span
                        :for={row <- @game.state["table"] || []}
                        class={"durak-table-pair #{if(row["defense"], do: "durak-table-pair--defended", else: "")}"}
                      ><span
                        class={[
                          "playing-card playing-card--table playing-card--attack",
                          card_suit(row["attack"]) in ["♥", "♦"] && "playing-card--red"
                        ]}
                        aria-label={"Атака: #{card_rank(row["attack"])}#{card_suit(row["attack"])}"}
                      ><.durak_card card={row["attack"]} /></span><span
                        :if={row["defense"]}
                        class={[
                          "playing-card playing-card--table playing-card--defense",
                          card_suit(row["defense"]) in ["♥", "♦"] && "playing-card--red"
                        ]}
                        aria-label={"Бьёт: #{card_rank(row["defense"])}#{card_suit(row["defense"])}"}
                      ><.durak_card card={row["defense"]} /></span></span>
                    </div><div
                      :if={player?(@game, @current_user)}
                      id="durak-hand"
                      class="mt-5 flex flex-wrap gap-2"
                    >
                      <button
                        :for={card <- hand(@game, @current_user)}
                        id={"card-#{String.replace(card, ~r/[^a-zA-Z0-9]/u, "-")}"}
                        phx-click="card"
                        phx-value-card={card}
                        data-game-sound="card"
                        disabled={!can_play_durak_card?(@game, @current_user)}
                        class={[
                          "playing-card",
                          card_suit(card) in ["♥", "♦"] && "playing-card--red"
                        ]}
                      ><.durak_card card={card} /></button>
                    </div><div :if={player?(@game, @current_user)} class="mt-4 flex gap-2">
                      <button
                        id="take-cards"
                        phx-click="take"
                        disabled={!can_take_durak?(@game, @current_user)}
                        class="rounded-lg border border-zinc-600 px-3 py-2"
                      >Взять</button><button
                        id="pass-cards"
                        phx-click="pass"
                        disabled={!can_pass_durak?(@game, @current_user)}
                        class="rounded-lg border border-zinc-600 px-3 py-2"
                      >Бито</button>
                    </div>
                  </div>
                  <div :if={@game.status != "finished" and @game.kind == "balda"}>
                    <p id="balda-turn" class="mb-3 text-sm text-zinc-400">
                      {if @game.status == "active",
                        do: "Ходит " <> player_name(@game, @game.state["turn_id"]),
                        else: "Партия завершена"}
                    </p><div
                      id="balda-board"
                      class="mx-auto grid aspect-square max-w-md grid-cols-5 overflow-hidden rounded-xl border-4 border-amber-900"
                    >
                      <button
                        :for={{row, col, square} <- squares(5)}
                        id={"balda-#{row}-#{col}"}
                        disabled={
                          !player?(@game, @current_user) or !current_turn?(@game, @current_user) or
                            !is_nil(balda_board(@game)[square]) or @game.status != "active"
                        }
                        phx-click="balda_square"
                        phx-value-square={square}
                        data-game-sound="tile"
                        class={[
                          "balda-tile border border-amber-800 bg-amber-100 text-lg font-black text-zinc-900",
                          @selected_square == square && "ring-4 ring-inset ring-cyan-400"
                        ]}
                      >{balda_board(@game)[square]}</button>
                    </div><.form
                      :if={player?(@game, @current_user) and @game.status == "active"}
                      for={@word_form}
                      id="balda-word-form"
                      phx-submit="word"
                      class="mt-4 flex flex-wrap gap-2"
                    >
                      <.input
                        field={@word_form[:letter]}
                        type="text"
                        label="Буква"
                        maxlength="1"
                      /><.input field={@word_form[:word]} type="text" label="Слово" /><button
                        id="submit-word"
                        class="self-end rounded-xl bg-amber-400 px-4 py-2 font-bold text-zinc-950"
                      >Сыграть</button><button
                        id="skip-balda"
                        type="button"
                        phx-click="skip"
                        class="self-end rounded-xl border border-zinc-700 px-4 py-2"
                      >Пропустить</button>
                    </.form><div id="balda-scores" class="mt-4 flex flex-wrap gap-3">
                      <span :for={player <- @game.players}>{display_name(player.user)}:
                      <strong>{score(@game, player.user_id)}</strong></span>
                    </div>
                  </div>
                </section>
              </main>
              <aside
                id="games-leaderboard"
                class="h-fit rounded-3xl border border-zinc-800 bg-zinc-900/80 p-5"
              >
                <h2 class="text-xl font-bold">Лидерборд</h2><p class="mt-1 text-sm text-zinc-500">
                  Завершённые партии
                </p><ol class="mt-5 space-y-3">
                  <li
                    :for={{row, index} <- Enum.with_index(@leaderboard, 1)}
                    id={"leaderboard-user-#{row.user.id}"}
                    class="flex items-center gap-3 rounded-xl bg-zinc-950/60 p-3"
                  >
                    <span class="grid size-8 place-items-center rounded-full bg-amber-400 font-black text-zinc-950">{index}</span><span class="min-w-0 flex-1 truncate font-semibold">{display_name(
                      row.user
                    )}</span><span class="text-right text-sm"><strong class="text-amber-300">{row.wins}</strong><small class="block text-zinc-500">из {row.played}</small></span>
                  </li><li
                    :if={@leaderboard == []}
                    id="games-leaderboard-empty"
                    class="text-sm text-zinc-500"
                  >
                    Первый чемпион ещё не определён.
                  </li>
                </ol>
              </aside>
            </div>
        <% end %>
      <% end %>
    </div>
    <script :type={Phoenix.LiveView.ColocatedHook} name=".GamesAuth">
      export default {
        mounted() {
          this.authenticate()
        },
        reconnected() {
          this.authenticate()
        },
        authenticate() {
          const token = sessionStorage.getItem("chat:user-auth")
          if (token) return this.pushEvent("authenticate_games", {token})

          try {
            const store = JSON.parse(localStorage.getItem("chat:guest-preferences") || "{}")
            const nickname = store.current_nickname
            const identityToken = nickname && store.by_nickname?.[nickname]?.identity_token
            this.pushEvent("authenticate_games", nickname && identityToken ? {guest_nickname: nickname, guest_identity_token: identityToken} : {})
          } catch (_error) {
            this.pushEvent("authenticate_games", {})
          }
        }
      }
    </script>
  </div>
</Layouts.app>
