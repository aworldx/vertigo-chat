<Layouts.app flash={@flash}>
  <main
    id="admin-page"
    class="min-h-dvh bg-zinc-950 px-4 py-8 text-zinc-100 sm:px-6 lg:px-8"
  >
    <div class="mx-auto max-w-5xl">
      <header class="flex flex-wrap items-start justify-between gap-4 border-b border-zinc-800 pb-6">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-amber-300">
            Служебный раздел
          </p>
          <h1 class="mt-2 text-3xl font-semibold tracking-tight text-zinc-100">Админка</h1>
        </div>
      </header>

      <section
        :if={@access == :checking}
        id="admin-checking"
        class="py-16 text-center text-sm text-zinc-400"
      >
        Проверяем доступ…
      </section>

      <section
        :if={@access == :unauthenticated}
        id="admin-login-required"
        class="mx-auto max-w-md py-12"
      >
        <div class="text-center">
          <.icon name="hero-lock-closed" class="mx-auto size-8 text-amber-300" />
          <h2 class="mt-4 text-xl font-semibold text-zinc-100">Вход администратора</h2>
          <p class="mt-2 text-sm leading-6 text-zinc-400">
            Введите данные учётной записи с правами администратора.
          </p>
        </div>

        <.form
          for={@login_form}
          id="admin-login-form"
          phx-submit="admin_login"
          class="mt-6 space-y-4"
        >
          <.input
            field={@login_form[:nickname]}
            label="Ник"
            autocomplete="username"
            required
          />
          <.input
            field={@login_form[:password]}
            type="password"
            label="Пароль"
            autocomplete="current-password"
            required
          />
          <p :if={@login_error} id="admin-login-error" class="text-sm text-red-300" role="alert">
            {@login_error}
          </p>
          <button
            id="admin-login-submit"
            type="submit"
            class="w-full rounded-lg bg-amber-300 px-4 py-3 text-sm font-semibold text-zinc-950 transition hover:bg-amber-200"
          >
            Войти в админку
          </button>
        </.form>
      </section>

      <section
        :if={@access == :forbidden}
        id="admin-forbidden"
        class="mx-auto max-w-lg py-16 text-center"
      >
        <.icon name="hero-shield-exclamation" class="mx-auto size-8 text-red-300" />
        <h2 class="mt-4 text-xl font-semibold text-zinc-100">Доступ закрыт</h2>
        <p class="mt-2 text-sm leading-6 text-zinc-400">
          Учётная запись {@current_user.nickname} не имеет прав администратора.
        </p>
      </section>

      <section :if={@access == :granted} id="admin-feedback-section" class="py-8">
        <section
          id="admin-emojis-section"
          class="mb-10 rounded-2xl border border-zinc-800 bg-zinc-900 p-5 sm:p-6"
        >
          <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-300">
                Смайлы
              </p>
              <h2 class="mt-1 text-2xl font-semibold text-zinc-100">Смайлы для сообщений</h2>
              <p class="mt-1 text-sm text-zinc-400">
                PNG до 30 × 30 px. Например, код <code>-ржу-</code>.
              </p>
            </div>
          </div>
          <.form
            for={@emoji_form}
            id="admin-emoji-form"
            phx-submit="upload_emoji"
            class="mt-5 grid gap-4 sm:grid-cols-[minmax(0,1fr)_auto]"
          >
            <.input field={@emoji_form[:code]} label="Код" placeholder="-ржу-" required />
            <div>
              <label for="emoji-image" class="mb-2 block text-sm font-semibold text-zinc-200">PNG-файл</label>
              <.live_file_input
                upload={@uploads.emoji_image}
                id="emoji-image"
                class="block w-full text-sm text-zinc-300"
              />
              <p
                :for={err <- upload_errors(@uploads.emoji_image)}
                class="mt-1 text-xs text-red-300"
              >
                {inspect(err)}
              </p>
            </div>
            <p
              :if={@emoji_upload_error}
              id="admin-emoji-error"
              class="text-sm text-red-300 sm:col-span-2"
              role="alert"
            >
              {@emoji_upload_error}
            </p>
            <button
              id="admin-emoji-submit"
              type="submit"
              class="w-fit rounded-lg bg-amber-300 px-4 py-2.5 text-sm font-semibold text-zinc-950 hover:bg-amber-200 sm:col-span-2"
            >Добавить смайл</button>
          </.form>
          <div id="admin-emojis-list" phx-update="stream" class="mt-5 flex flex-wrap gap-2">
            <div
              :for={{dom_id, emoji} <- @streams.emojis}
              id={dom_id}
              class="inline-flex items-center gap-2 rounded-lg border border-zinc-700 bg-zinc-950 px-2 py-1 text-sm text-zinc-200"
            >
              <img src={emoji_url(emoji)} alt={emoji.code} class="size-[30px] object-contain" />
              <code>{emoji.code}</code>
            </div>
          </div>
        </section>
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-300">
              Обратная связь
            </p>
            <h2 class="mt-1 text-2xl font-semibold text-zinc-100">Пожелания пользователей</h2>
          </div>
          <span
            id="admin-feedback-count"
            class="rounded-full border border-amber-300/30 bg-amber-300/10 px-3 py-1 text-sm font-semibold text-amber-100"
          >
            {@feedback_count}
          </span>
        </div>

        <p
          :if={@feedback_count == 0}
          id="admin-feedback-empty"
          class="mt-8 rounded-2xl border border-dashed border-zinc-700 p-6 text-center text-sm text-zinc-400"
        >
          Обратной связи пока нет.
        </p>

        <div id="admin-feedback-list" phx-update="stream" class="mt-6 space-y-3">
          <article
            :for={{dom_id, entry} <- @streams.feedback_entries}
            id={dom_id}
            class="rounded-2xl border border-zinc-800 bg-zinc-900 p-5"
          >
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div class="flex items-center gap-2">
                <span class="font-semibold text-zinc-100">{entry.name}</span>
                <span class="rounded-full bg-zinc-800 px-2 py-0.5 text-xs text-zinc-400">
                  {if entry.user, do: "Зарегистрирован", else: "Гость"}
                </span>
              </div>
              <time datetime={entry.inserted_at} class="text-xs text-zinc-500">
                {feedback_timestamp(entry)}
              </time>
            </div>
            <p class="mt-4 whitespace-pre-wrap text-sm leading-6 text-zinc-300">{entry.body}</p>
          </article>
        </div>
      </section>
    </div>
  </main>
</Layouts.app>
