<Layouts.app flash={@flash}>
  <section
    id="chat-room"
    phx-hook="ChatPreferences"
    phx-disconnected={
      JS.set_attribute({"hidden", ""}, to: "#current-chatlan-online")
      |> JS.remove_attribute("hidden", to: "#current-chatlan-reconnecting")
    }
    phx-connected={
      JS.set_attribute({"hidden", ""}, to: "#current-chatlan-reconnecting")
      |> JS.remove_attribute("hidden", to: "#current-chatlan-online")
    }
    data-chat-theme={@theme_id}
    data-chat-mode={@theme_mode}
    data-chat-joined={to_string(@joined?)}
    class="chat-shell relative isolate flex h-dvh max-h-dvh min-h-0 flex-col overflow-hidden bg-zinc-950 text-zinc-100"
  >
    <ShellComponents.top_menu joined={@joined?} registered={not is_nil(@current_user)} />

    <div class="grid min-h-0 flex-1 grid-cols-1 md:grid-cols-[minmax(0,1fr)_17rem]">
      <%= if @joined? do %>
        <RoomComponents.dialogue_frame
          nickname={@nickname}
          peer_id={@presence_key}
          messages={@streams.messages}
          appearance={@appearance}
          online={@online}
          emojis={@emojis}
          typing={@typing_peers |> Map.values() |> Enum.sort()}
          preserve_message_dom?={@preserve_message_dom?}
        />
      <% else %>
        <main
          id="chat-session-restoring"
          class="hidden min-h-0 items-center justify-center overflow-y-auto border-b border-zinc-800 bg-zinc-950 p-4 md:border-b-0 md:border-r"
          aria-live="polite"
        >
          <p class="text-sm text-zinc-400">Восстанавливаем сессию…</p>
        </main>
        <main
          id="chat-entrance-screen"
          class="flex min-h-0 flex-col items-center justify-center overflow-y-auto border-b border-zinc-800 bg-zinc-950 p-4 md:border-b-0 md:border-r"
        >
          <div
            id="chat-session-restore-timeout"
            class="mb-4 hidden max-w-md rounded-lg border border-amber-300/50 bg-amber-300/10 p-3 text-sm text-amber-100"
            role="status"
          >
            Связь пока не восстановилась. Сессия сохранена: проверь подключение и обнови страницу,
            когда интернет появится.
          </div>
          <%= if @screen == :registration do %>
            <AuthComponents.registration_screen
              registration_form={@registration_form}
              registration_error={@registration_error}
            />
          <% else %>
            <div class="w-full max-w-md text-center">
              <h1 class="text-3xl font-semibold">Вход в чат</h1>
              <p class="mt-3 text-sm leading-6 text-zinc-400">
                Войди на главной странице, чтобы присоединиться к разговору.
              </p>
              <p
                :if={@entrance_error}
                id="entrance-error"
                role="alert"
                class="mt-4 text-sm text-amber-100"
              >
                {@entrance_error}
              </p>
              <.link
                id="chat-login-link"
                navigate={~p"/"}
                class="mt-6 inline-flex rounded bg-amber-300 px-5 py-3 text-sm font-semibold text-zinc-950 transition hover:bg-amber-200"
              >Войти на главной</.link>
            </div>
          <% end %>
        </main>
      <% end %>

      <RoomComponents.chatlan_sidebar
        joined={@joined?}
        online={@online}
        peer_id={@presence_key}
        karmik_mood={@karmik_mood}
      />
    </div>

    <%= if @joined? do %>
      <RoomComponents.message_input
        message_form={@message_form}
        message_error={@message_error}
        media_error={@media_error}
        registered={not is_nil(@current_user)}
        peer_id={@presence_key}
        ice_servers={Chat.MediaShares.ice_servers()}
      />
    <% end %>

    <%= if @profile do %>
      <RoomComponents.profile_modal
        profile={@profile}
        form={@profile_form}
        editable={@profile_editable?}
        editing={@profile_editing?}
        uploads={@uploads}
      />
    <% end %>

    <%= if @feedback_open? do %>
      <RoomComponents.feedback_modal
        form={@feedback_form}
        registered={not is_nil(@current_user)}
        nickname={@nickname}
      />
    <% end %>

    <%= if @joined? && @settings_open? do %>
      <RoomComponents.settings_modal
        settings_form={@settings_form}
        themes={@themes}
        theme_id={@settings_theme_id}
        theme_modes={@theme_modes}
        appearance={@settings_appearance}
        fonts={@fonts}
        font_id={@settings_font_id}
        font_styles={@font_styles}
        font_style={@settings_font_style}
        message_sound_enabled={@settings_message_sound_enabled}
        nickname={@nickname}
      />
    <% end %>

    <%= if @joined? && @registration_open? do %>
      <div
        id="registration-modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="registration-modal-title"
        class="fixed inset-0 z-50 flex items-center justify-center bg-zinc-950/85 p-4 backdrop-blur-sm"
      >
        <div class="max-h-[92vh] w-full max-w-md overflow-y-auto rounded-2xl border border-zinc-700 bg-zinc-900 p-6 shadow-2xl">
          <AuthComponents.registration_screen
            registration_form={@registration_form}
            registration_error={@registration_error}
            in_chat
          />
        </div>
      </div>
    <% end %>
  </section>
</Layouts.app>
