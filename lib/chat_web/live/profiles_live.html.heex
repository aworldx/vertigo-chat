<Layouts.app flash={@flash}>
  <section
    id="profiles-page"
    phx-hook=".ProfilePhotoLightbox"
    class="chat-shell min-h-screen bg-zinc-950 text-zinc-100"
    data-chat-theme="vertigo"
    data-chat-mode="dark"
  >
    <header class="flex min-h-16 items-center justify-between border-b border-zinc-800 bg-zinc-900 px-4 sm:px-8">
      <a href={~p"/"} target="vertigo-chat" data-return-to-chat class="flex items-center gap-3">
        <span class="vertigo-mark" aria-hidden="true"></span>
        <span class="vertigo-wordmark uppercase">Vertigo</span>
      </a>
      <.link
        href={~p"/"}
        target="vertigo-chat"
        data-return-to-chat
        class="flex items-center gap-2 text-sm text-zinc-300 transition hover:text-amber-300"
      >
        <.icon name="hero-arrow-left" class="size-4" /> Вернуться в чат
      </.link>
    </header>

    <main class="mx-auto w-full max-w-7xl px-4 py-10 sm:px-8">
      <div class="flex flex-col gap-6 border-b border-zinc-800 pb-8 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-rose-300">
            Досье чатлан
          </p>
          <h1 class="mt-2 text-4xl font-semibold sm:text-5xl">Анкеты</h1>
          <p id="profiles-total" class="mt-3 text-sm text-zinc-400">
            Найдено: {@total}
          </p>
        </div>

        <.form for={@search_form} id="profile-search" phx-change="search" class="w-full max-w-md">
          <label
            for="profile-search-query"
            class="mb-2 block text-xs uppercase tracking-[0.16em] text-zinc-400"
          >
            Поиск по нику или имени
          </label>
          <div class="relative">
            <.icon
              name="hero-magnifying-glass"
              class="pointer-events-none absolute left-3 top-1/2 size-5 -translate-y-1/2 text-zinc-500"
            />
            <input
              id="profile-search-query"
              name={@search_form[:query].name}
              value={@search_form[:query].value}
              phx-debounce="300"
              autocomplete="off"
              placeholder="Например, Scottie"
              class="w-full rounded-xl border border-zinc-700 bg-zinc-950 py-3 pl-11 pr-4 text-sm text-zinc-100 outline-none transition placeholder:text-zinc-600 focus:border-amber-300"
            />
          </div>
        </.form>
      </div>

      <div
        id="profiles"
        phx-update="stream"
        class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
      >
        <div
          id="profiles-empty"
          class="col-span-full hidden rounded-2xl border border-dashed border-zinc-700 px-6 py-16 text-center text-zinc-400 only:block"
        >
          По этому запросу анкет не найдено.
        </div>
        <button
          :for={{dom_id, profile} <- @streams.profiles}
          id={dom_id}
          type="button"
          phx-click="open_profile"
          phx-value-nickname={profile.user.nickname}
          data-profile-nickname={profile.user.nickname}
          aria-label={"Открыть анкету #{profile.user.nickname}"}
          class="group overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900/80 text-left shadow-lg transition duration-300 hover:-translate-y-1 hover:border-rose-300/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-300"
        >
          <div class="aspect-[4/3] overflow-hidden bg-zinc-950">
            <%= if photo_url(profile) do %>
              <img
                src={photo_url(profile)}
                alt={"Фото #{profile.user.nickname}"}
                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
              />
            <% else %>
              <div class="flex h-full items-center justify-center bg-[radial-gradient(circle_at_center,rgba(190,18,60,0.2),transparent_65%)] text-zinc-700">
                <.icon name="hero-user" class="size-20" />
              </div>
            <% end %>
          </div>
          <div class="p-5">
            <h2 class="truncate text-2xl">{profile.user.nickname}</h2>
            <p class="mt-1 truncate text-sm text-amber-200/80">
              {profile.name || "Имя не указано"}
            </p>
            <div class="mt-4 flex items-center gap-2 text-xs text-zinc-500">
              <span>{gender_label(profile.gender)}</span>
              <%= if profile.birth_date do %>
                <span aria-hidden="true">·</span>
                <span>{Calendar.strftime(profile.birth_date, "%d.%m.%Y")}</span>
              <% end %>
            </div>
            <p class="mt-4 line-clamp-3 min-h-[4.5rem] text-sm leading-6 text-zinc-400">
              {profile.about || "Пользователь пока ничего о себе не рассказал."}
            </p>
          </div>
        </button>
      </div>

      <nav
        id="profiles-pagination"
        aria-label="Страницы анкет"
        class="mt-10 flex items-center justify-center gap-2"
      >
        <.link
          :if={@page > 1}
          patch={~p"/profiles?#{%{q: @search, page: @page - 1}}"}
          id="profiles-previous"
          class="rounded-lg border border-zinc-700 px-3 py-2 text-sm text-zinc-300 transition hover:border-amber-300 hover:text-amber-300"
        >
          Назад
        </.link>
        <.link
          :for={page <- @pages}
          patch={~p"/profiles?#{%{q: @search, page: page}}"}
          id={"profiles-page-#{page}"}
          class={[
            "flex size-10 items-center justify-center rounded-lg border text-sm transition",
            page == @page && "border-rose-300 bg-rose-300/15 text-rose-100",
            page != @page &&
              "border-zinc-700 text-zinc-400 hover:border-amber-300 hover:text-amber-300"
          ]}
        >
          {page}
        </.link>
        <.link
          :if={@page < @total_pages}
          patch={~p"/profiles?#{%{q: @search, page: @page + 1}}"}
          id="profiles-next"
          class="rounded-lg border border-zinc-700 px-3 py-2 text-sm text-zinc-300 transition hover:border-amber-300 hover:text-amber-300"
        >
          Далее
        </.link>
      </nav>
    </main>

    <div
      :if={@selected_profile}
      id="profile-viewer"
      role="dialog"
      aria-modal="true"
      aria-labelledby="profile-viewer-title"
      class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-8"
    >
      <button
        id="close-profile-viewer-backdrop"
        type="button"
        phx-click="close_profile"
        aria-label="Закрыть анкету"
        class="absolute inset-0 bg-zinc-950/85 backdrop-blur-sm"
      ></button>

      <article class="relative z-10 max-h-full w-full max-w-3xl overflow-y-auto rounded-2xl border border-zinc-700 bg-zinc-900 shadow-2xl">
        <button
          id="close-profile-viewer"
          type="button"
          phx-click="close_profile"
          aria-label="Закрыть анкету"
          class="absolute right-3 top-3 z-20 flex size-10 items-center justify-center rounded-full border border-zinc-600 bg-zinc-950/80 text-zinc-200 transition hover:border-amber-300 hover:text-amber-200"
        >
          <.icon name="hero-x-mark" class="size-5" />
        </button>

        <div class="grid md:grid-cols-[minmax(0,20rem)_1fr]">
          <div class="min-h-64 bg-zinc-950">
            <%= if photo_url(@selected_profile) do %>
              <button
                id="open-profile-photo"
                type="button"
                data-profile-lightbox-open
                aria-label={"Увеличить фото #{@selected_profile.user.nickname}"}
                aria-haspopup="dialog"
                class="group/photo relative block h-full min-h-64 w-full cursor-zoom-in overflow-hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-amber-300"
              >
                <img
                  src={photo_url(@selected_profile)}
                  alt={"Фото #{@selected_profile.user.nickname}"}
                  class="h-full min-h-64 w-full object-cover transition duration-500 group-hover/photo:scale-[1.02]"
                />
                <span class="absolute right-4 top-4 flex size-10 items-center justify-center rounded-full border border-white/15 bg-zinc-950/65 text-zinc-100 shadow-lg backdrop-blur-sm">
                  <.icon name="hero-arrows-pointing-out" class="size-5" />
                </span>
              </button>
            <% else %>
              <div class="flex h-full min-h-64 items-center justify-center text-zinc-700">
                <.icon name="hero-user" class="size-24" />
              </div>
            <% end %>
          </div>

          <div class="p-6 sm:p-8">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-rose-300">Анкета</p>
            <h2 id="profile-viewer-title" class="mt-2 text-3xl font-semibold">
              {@selected_profile.user.nickname}
            </h2>
            <p class="mt-2 text-lg text-amber-200/90">
              {@selected_profile.name || "Имя не указано"}
            </p>
            <dl class="mt-6 grid grid-cols-[auto_1fr] gap-x-4 gap-y-3 text-sm">
              <dt class="text-zinc-500">Пол</dt>
              <dd class="text-zinc-200">{gender_label(@selected_profile.gender)}</dd>
              <dt class="text-zinc-500">Дата рождения</dt>
              <dd class="text-zinc-200">
                {if(@selected_profile.birth_date,
                  do: Calendar.strftime(@selected_profile.birth_date, "%d.%m.%Y"),
                  else: "Не указана"
                )}
              </dd>
            </dl>
            <div class="mt-7 border-t border-zinc-800 pt-6">
              <h3 class="text-xs font-semibold uppercase tracking-[0.16em] text-zinc-500">
                О себе
              </h3>
              <p class="mt-3 whitespace-pre-wrap text-sm leading-7 text-zinc-300">
                {@selected_profile.about || "Пользователь пока ничего о себе не рассказал."}
              </p>
            </div>
          </div>
        </div>
      </article>
    </div>

    <div
      id="profile-photo-lightbox"
      phx-update="ignore"
      role="dialog"
      aria-modal="true"
      aria-hidden="true"
      aria-labelledby="profile-photo-lightbox-title"
      inert
      class="pointer-events-none invisible fixed inset-0 z-[100] flex items-center justify-center p-4 opacity-0 transition duration-200 sm:p-8"
    >
      <button
        type="button"
        data-profile-lightbox-close
        aria-label="Закрыть увеличенное фото"
        class="absolute inset-0 cursor-zoom-out bg-zinc-950/90 backdrop-blur-md"
      ></button>
      <figure class="relative z-10 flex max-h-full max-w-full flex-col items-center gap-4">
        <img
          id="profile-photo-lightbox-image"
          src=""
          alt=""
          class="max-h-[calc(100vh-8rem)] max-w-[min(92vw,90rem)] scale-95 rounded-xl object-contain shadow-2xl ring-1 ring-white/10 transition duration-200"
        />
        <figcaption id="profile-photo-lightbox-title" class="text-center text-sm text-zinc-300">
          Просмотр фотографии
        </figcaption>
      </figure>
      <button
        id="close-profile-photo-lightbox"
        type="button"
        data-profile-lightbox-close
        aria-label="Закрыть"
        class="absolute right-4 top-4 z-20 flex size-11 items-center justify-center rounded-full border border-white/15 bg-zinc-900/80 text-zinc-100 shadow-xl backdrop-blur-sm transition hover:border-amber-300 hover:text-amber-200 sm:right-7 sm:top-7"
      >
        <.icon name="hero-x-mark" class="size-6" />
      </button>
    </div>

    <script :type={Phoenix.LiveView.ColocatedHook} name=".ProfilePhotoLightbox">
      export default {
        mounted() {
          this.lightbox = this.el.querySelector("#profile-photo-lightbox")
          this.image = this.el.querySelector("#profile-photo-lightbox-image")
          this.title = this.el.querySelector("#profile-photo-lightbox-title")
          this.closeButton = this.el.querySelector("#close-profile-photo-lightbox")

          this.open = button => {
            const sourceImage = button.querySelector("img")
            if (!sourceImage) return

            this.previousFocus = button
            this.image.src = sourceImage.currentSrc || sourceImage.src
            this.image.alt = sourceImage.alt
            this.title.textContent = sourceImage.alt
            this.lightbox.inert = false
            this.lightbox.setAttribute("aria-hidden", "false")
            this.lightbox.classList.remove("pointer-events-none", "invisible", "opacity-0")
            this.lightbox.classList.add("opacity-100")
            this.image.classList.replace("scale-95", "scale-100")
            document.body.classList.add("overflow-hidden")
            this.closeButton.focus()
          }

          this.close = () => {
            if (this.lightbox.getAttribute("aria-hidden") === "true") return

            this.lightbox.setAttribute("aria-hidden", "true")
            this.lightbox.classList.add("pointer-events-none", "invisible", "opacity-0")
            this.lightbox.classList.remove("opacity-100")
            this.image.classList.replace("scale-100", "scale-95")
            this.image.removeAttribute("src")
            document.body.classList.remove("overflow-hidden")
            this.previousFocus?.focus()
          }

          this.onClick = event => {
            const openButton = event.target.closest("[data-profile-lightbox-open]")
            if (openButton) this.open(openButton)

            const closeButton = event.target.closest("[data-profile-lightbox-close]")
            if (closeButton && this.lightbox.contains(closeButton)) this.close()
          }
          this.onKeydown = event => {
            if (event.key === "Escape") this.close()
          }
          document.addEventListener("click", this.onClick)
          document.addEventListener("keydown", this.onKeydown)
        },
        destroyed() {
          document.removeEventListener("click", this.onClick)
          document.removeEventListener("keydown", this.onKeydown)
          document.body.classList.remove("overflow-hidden")
        }
      }
    </script>
  </section>
</Layouts.app>
