<Layouts.app flash={@flash}>
  <main id="vertigo-landing" class="min-h-dvh bg-zinc-950 text-zinc-100">
    <header class="mx-auto flex max-w-6xl items-center justify-between px-5 py-5 sm:px-8">
      <a href={~p"/about"} class="flex items-center gap-3" aria-label="Vertigo — о чате">
        <span class="vertigo-mark" aria-hidden="true"></span>
        <span class="vertigo-wordmark uppercase">Vertigo</span>
      </a>
      <a
        id="landing-enter-chat-header"
        href={~p"/"}
        class="rounded-lg border border-amber-300/70 px-4 py-2 text-sm font-semibold text-amber-100 transition hover:bg-amber-300 hover:text-zinc-950"
      >
        Войти в чат
      </a>
    </header>

    <section class="mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:px-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-center lg:py-28">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-amber-300">
          Vertigo chat
        </p>
        <h1 class="mt-5 max-w-3xl text-4xl font-black tracking-tight text-balance sm:text-6xl">
          Общайся, знакомься и играй вместе
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-zinc-300">
          Vertigo — русскоязычный чат, в котором можно встретить новых людей, играть в компании
          и оставаться на связи в общем разговоре.
        </p>
        <div class="mt-9 flex flex-wrap gap-4">
          <a
            id="landing-enter-chat"
            href={~p"/"}
            class="rounded-lg bg-amber-300 px-5 py-3 font-bold text-zinc-950 transition hover:bg-amber-200"
          >
            Перейти в чат
          </a>
          <a
            id="landing-open-games"
            href={~p"/games"}
            class="rounded-lg border border-zinc-700 px-5 py-3 font-semibold text-zinc-100 transition hover:border-zinc-500 hover:bg-zinc-900"
          >
            Посмотреть игры
          </a>
        </div>
      </div>

      <aside class="rounded-3xl border border-zinc-700 bg-zinc-900 p-7 shadow-2xl shadow-black/30">
        <h2 class="text-2xl font-bold">В одном месте</h2>
        <ul class="mt-6 space-y-5 text-zinc-300">
          <li class="flex gap-3">
            <.icon
              name="hero-chat-bubble-left-right"
              class="mt-0.5 size-5 shrink-0 text-amber-300"
            />Общий разговор с другими чатланами
          </li>
          <li class="flex gap-3">
            <.icon name="hero-puzzle-piece" class="mt-0.5 size-5 shrink-0 text-amber-300" />Шашки, морской бой, дурак и балда
          </li>
          <li class="flex gap-3">
            <.icon name="hero-photo" class="mt-0.5 size-5 shrink-0 text-amber-300" />Анкеты, фотоальбом и библиотека сообщества
          </li>
        </ul>
      </aside>
    </section>

    <section class="border-y border-zinc-800 bg-zinc-900/60">
      <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
        <h2 class="text-3xl font-bold">Чем заняться в Vertigo</h2>
        <div class="mt-8 grid gap-5 md:grid-cols-3">
          <a
            href={~p"/games"}
            class="rounded-2xl border border-zinc-700 p-6 transition hover:border-amber-300 hover:bg-zinc-900"
          >
            <h3 class="text-xl font-bold text-amber-200">Игры</h3>
            <p class="mt-3 leading-7 text-zinc-300">
              Создавай игровой стол и зови чатлан присоединиться.
            </p>
          </a>
          <a
            href={~p"/library"}
            class="rounded-2xl border border-zinc-700 p-6 transition hover:border-amber-300 hover:bg-zinc-900"
          >
            <h3 class="text-xl font-bold text-amber-200">Библиотека</h3>
            <p class="mt-3 leading-7 text-zinc-300">
              Находи книги и поводы для нового разговора.
            </p>
          </a>
          <a
            href={~p"/help"}
            class="rounded-2xl border border-zinc-700 p-6 transition hover:border-amber-300 hover:bg-zinc-900"
          >
            <h3 class="text-xl font-bold text-amber-200">Правила и помощь</h3>
            <p class="mt-3 leading-7 text-zinc-300">
              Узнай о возможностях чата и рангах участников.
            </p>
          </a>
          <a
            href={~p"/articles"}
            class="rounded-2xl border border-zinc-700 p-6 transition hover:border-amber-300 hover:bg-zinc-900"
          >
            <h3 class="text-xl font-bold text-amber-200">Статьи</h3>
            <p class="mt-3 leading-7 text-zinc-300">
              Читай о чатах, знакомстве и общении в сети.
            </p>
          </a>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
      <h2 class="text-3xl font-bold">Вопросы о чате</h2>
      <div class="mt-8 grid gap-5 md:grid-cols-2">
        <div class="rounded-2xl border border-zinc-800 p-6">
          <h3 class="text-lg font-bold">Что можно делать в Vertigo?</h3>
          <p class="mt-3 leading-7 text-zinc-300">
            Общаться в общей комнате, смотреть анкеты, играть и пользоваться разделами сообщества.
          </p>
        </div>
        <div class="rounded-2xl border border-zinc-800 p-6">
          <h3 class="text-lg font-bold">Как начать общение?</h3>
          <p class="mt-3 leading-7 text-zinc-300">
            Перейди в чат, выбери ник и присоединяйся к разговору.
          </p>
        </div>
      </div>
    </section>
  </main>
</Layouts.app>
