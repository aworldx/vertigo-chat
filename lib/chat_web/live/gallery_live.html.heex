<Layouts.app flash={@flash}>
  <section
    id="gallery-page"
    phx-hook=".GalleryAuth"
    class="chat-shell min-h-screen bg-zinc-950 text-zinc-100"
    data-chat-theme="vertigo"
    data-chat-mode="dark"
  >
    <header class="flex min-h-16 items-center justify-between border-b border-zinc-800 bg-zinc-900 px-4 sm:px-8">
      <a href={~p"/"} class="flex items-center gap-3">
        <svg class="vertigo-mark" viewBox="0 0 50 50" fill="none" aria-hidden="true">
          <path
            d="M5 25C5 13.4 14.4 4 26 4s20 9.4 20 21-9.4 21-21 21S7 37.9 7 27 15.1 9 26 9s18 8.1 18 18-7.2 16-17 16-15-6.2-15-15 0-14 14-14 14 5.4 14 13-5.4 12-13 12-11-4.6-11-11 4.6-10 11-10 8 3.6 8 8-3.6 7-8 7-5-2.6-5-6 2.6-5 6-5 4 1.8 4 4-1.8 3-4 3-2 0-3-1.3-3-3"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        <span class="vertigo-wordmark uppercase">Vertigo</span>
      </a>
      <.link
        href={~p"/"}
        class="flex items-center gap-2 text-sm text-zinc-300 transition hover:text-amber-300"
      >
        <.icon name="hero-arrow-left" class="size-4" /> Вернуться в чат
      </.link>
    </header>

    <main class="mx-auto w-full max-w-7xl px-4 py-10 sm:px-8">
      <div class="flex flex-col gap-6 border-b border-zinc-800 pb-8 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-rose-300">
            Моменты Vertigo
          </p>
          <h1 class="mt-2 text-4xl font-semibold sm:text-5xl">Фотоальбом</h1>
          <p class="mt-3 max-w-xl text-sm leading-6 text-zinc-400">
            Общая коллекция снимков чатлан. Загружать фотографии могут зарегистрированные пользователи после входа в чат.
          </p>
        </div>

        <%= cond do %>
          <% @current_user -> %>
            <.form
              for={@upload_form}
              id="gallery-upload-form"
              phx-change="validate_gallery_photo"
              phx-submit="upload_gallery_photo"
              class="w-full max-w-md rounded-2xl border border-zinc-700 bg-zinc-900/80 p-4"
            >
              <p class="mb-3 text-sm text-zinc-300">
                Загрузить как <strong class="text-amber-200">{@current_user.nickname}</strong>
              </p>
              <div
                id="gallery-photo-compressor"
                phx-hook=".GalleryPhotoCompressor"
                class="flex items-center gap-3"
              >
                <.live_file_input
                  upload={@uploads.gallery_photo}
                  class="min-w-0 flex-1 text-xs text-zinc-400 file:mr-2 file:rounded-lg file:border-0 file:bg-zinc-700 file:px-3 file:py-2 file:text-zinc-100"
                />
                <button
                  id="upload-gallery-photo"
                  type="submit"
                  phx-disable-with="Загрузка…"
                  class="shrink-0 rounded-lg bg-amber-300 px-4 py-2 text-sm font-semibold text-zinc-950 transition hover:bg-amber-200"
                >
                  Добавить
                </button>
              </div>
              <p class="mt-2 text-xs text-zinc-500">
                JPG, PNG или WebP. Снимок будет уменьшен до 1600 px.
              </p>
              <%= if upload_errors(@uploads.gallery_photo) != [] do %>
                <p id="gallery-upload-error" class="mt-2 text-xs text-red-300">
                  Выберите изображение размером до 2 МБ после сжатия.
                </p>
              <% end %>
            </.form>
          <% @auth_checked? -> %>
            <div
              id="gallery-login-hint"
              class="max-w-md rounded-2xl border border-zinc-700 bg-zinc-900/70 px-5 py-4 text-sm leading-6 text-zinc-400"
            >
              Чтобы добавить снимок, войдите в чат с зарегистрированным ником.
            </div>
          <% true -> %>
            <div id="gallery-auth-check" class="text-sm text-zinc-500">Проверяем вход…</div>
        <% end %>
      </div>

      <div
        id="gallery-photos"
        phx-update="stream"
        class="mt-8 columns-1 gap-5 sm:columns-2 lg:columns-3 xl:columns-4"
      >
        <div
          id="gallery-empty"
          class="hidden rounded-2xl border border-dashed border-zinc-700 px-6 py-20 text-center text-zinc-400 only:block"
        >
          В альбоме пока нет фотографий. Станьте первым автором.
        </div>
        <figure
          :for={{dom_id, photo} <- @streams.photos}
          id={dom_id}
          data-photo-author={photo.user.nickname}
          class="group relative mb-5 break-inside-avoid overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900 shadow-xl"
        >
          <button
            type="button"
            data-gallery-lightbox-open
            aria-label={"Увеличить фотографию от #{photo.user.nickname}"}
            aria-haspopup="dialog"
            class="block w-full cursor-zoom-in overflow-hidden outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-amber-300"
          >
            <img
              src={image_url(photo)}
              alt={"Фотография от #{photo.user.nickname}"}
              loading="lazy"
              class="block h-auto w-full transition duration-500 group-hover:scale-[1.02]"
            />
            <span class="absolute right-3 top-3 flex size-9 items-center justify-center rounded-full border border-white/15 bg-zinc-950/65 text-zinc-100 opacity-0 shadow-lg backdrop-blur-sm transition group-hover:opacity-100 group-focus-within:opacity-100">
              <.icon name="hero-arrows-pointing-out" class="size-4" />
            </span>
          </button>
          <figcaption class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-zinc-950 via-zinc-950/80 to-transparent px-4 pb-4 pt-12">
            <div class="flex items-end justify-between gap-3">
              <div>
                <p class="text-xs uppercase tracking-[0.16em] text-zinc-400">Загрузил</p>
                <p class="chat-user-nickname mt-1 text-lg font-semibold">{photo.user.nickname}</p>
              </div>
              <time class="text-xs text-zinc-500">{Calendar.strftime(
                photo.inserted_at,
                "%d.%m.%Y"
              )}</time>
            </div>
          </figcaption>
        </figure>
      </div>
    </main>

    <div
      id="gallery-lightbox"
      phx-hook=".GalleryLightbox"
      phx-update="ignore"
      role="dialog"
      aria-modal="true"
      aria-hidden="true"
      aria-labelledby="gallery-lightbox-title"
      inert
      class="pointer-events-none invisible fixed inset-0 z-[100] flex items-center justify-center p-4 opacity-0 transition duration-200 sm:p-8"
    >
      <button
        type="button"
        data-gallery-lightbox-close
        aria-label="Закрыть увеличенную фотографию"
        class="absolute inset-0 cursor-zoom-out bg-zinc-950/90 backdrop-blur-md"
      ></button>

      <figure class="relative z-10 flex max-h-full max-w-full flex-col items-center gap-4">
        <img
          id="gallery-lightbox-image"
          src=""
          alt=""
          class="max-h-[calc(100vh-8rem)] max-w-[min(92vw,90rem)] scale-95 rounded-xl object-contain shadow-2xl ring-1 ring-white/10 transition duration-200"
        />
        <figcaption
          id="gallery-lightbox-title"
          class="max-w-3xl text-center text-sm text-zinc-300"
        >
          Просмотр фотографии
        </figcaption>
      </figure>

      <button
        id="close-gallery-lightbox"
        type="button"
        data-gallery-lightbox-close
        aria-label="Закрыть"
        class="absolute right-4 top-4 z-20 flex size-11 items-center justify-center rounded-full border border-white/15 bg-zinc-900/80 text-zinc-100 shadow-xl backdrop-blur-sm transition hover:scale-105 hover:border-amber-300 hover:text-amber-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-300 sm:right-7 sm:top-7"
      >
        <.icon name="hero-x-mark" class="size-6" />
      </button>
    </div>

    <script :type={Phoenix.LiveView.ColocatedHook} name=".GalleryLightbox">
      export default {
        mounted() {
          this.image = this.el.querySelector("#gallery-lightbox-image")
          this.title = this.el.querySelector("#gallery-lightbox-title")
          this.closeButton = this.el.querySelector("#close-gallery-lightbox")
          this.hideTimer = null

          this.open = button => {
            const sourceImage = button.querySelector("img")
            if (!sourceImage) return

            clearTimeout(this.hideTimer)
            this.previousFocus = button
            this.image.src = sourceImage.currentSrc || sourceImage.src
            this.image.alt = sourceImage.alt
            this.title.textContent = sourceImage.alt
            this.el.inert = false
            this.el.setAttribute("aria-hidden", "false")
            this.el.classList.remove("pointer-events-none", "invisible", "opacity-0")
            this.el.classList.add("opacity-100")
            this.image.classList.remove("scale-95")
            this.image.classList.add("scale-100")
            document.body.classList.add("overflow-hidden")
            this.closeButton.focus()
          }

          this.close = () => {
            if (this.el.getAttribute("aria-hidden") === "true") return

            this.el.setAttribute("aria-hidden", "true")
            this.el.classList.add("pointer-events-none", "opacity-0")
            this.el.classList.remove("opacity-100")
            this.image.classList.add("scale-95")
            this.image.classList.remove("scale-100")
            document.body.classList.remove("overflow-hidden")
            this.previousFocus?.focus()

            this.hideTimer = setTimeout(() => {
              this.el.classList.add("invisible")
              this.el.inert = true
              this.image.removeAttribute("src")
            }, 200)
          }

          this.onClick = event => {
            const openButton = event.target.closest("[data-gallery-lightbox-open]")
            if (openButton) this.open(openButton)

            const closeButton = event.target.closest("[data-gallery-lightbox-close]")
            if (closeButton && this.el.contains(closeButton)) this.close()
          }

          this.onKeydown = event => {
            if (event.key === "Escape") this.close()
          }

          document.addEventListener("click", this.onClick)
          document.addEventListener("keydown", this.onKeydown)
        },
        destroyed() {
          clearTimeout(this.hideTimer)
          document.removeEventListener("click", this.onClick)
          document.removeEventListener("keydown", this.onKeydown)
          document.body.classList.remove("overflow-hidden")
        }
      }
    </script>

    <script :type={Phoenix.LiveView.ColocatedHook} name=".GalleryAuth">
      export default {
        mounted() {
          this.authenticate = () => {
            const token = localStorage.getItem("chat:user-auth")
            this.pushEvent("authenticate_gallery", token ? {token} : {})
          }
          this.onStorage = event => {
            if (event.key === "chat:user-auth") this.authenticate()
          }
          this.authenticate()
          window.addEventListener("storage", this.onStorage)
        },
        destroyed() {
          window.removeEventListener("storage", this.onStorage)
        }
      }
    </script>

    <script :type={Phoenix.LiveView.ColocatedHook} name=".GalleryPhotoCompressor">
      export default {
        mounted() {
          this.el.addEventListener("change", async event => {
            const input = event.target
            if (input.dataset.compressed || !input.files?.[0]) return
            event.preventDefault()
            event.stopImmediatePropagation()

            const image = await createImageBitmap(input.files[0])
            const scale = Math.min(1, 1600 / image.width, 1600 / image.height)
            const canvas = document.createElement("canvas")
            canvas.width = Math.max(1, Math.round(image.width * scale))
            canvas.height = Math.max(1, Math.round(image.height * scale))
            canvas.getContext("2d").drawImage(image, 0, 0, canvas.width, canvas.height)
            image.close()

            const blob = await new Promise(resolve => canvas.toBlob(resolve, "image/webp", 0.82))
            const files = new DataTransfer()
            files.items.add(new File([blob], "gallery-photo.webp", {type: "image/webp"}))
            input.files = files.files
            input.dataset.compressed = "true"
            input.dispatchEvent(new Event("change", {bubbles: true}))
          }, true)
        }
      }
    </script>
  </section>
</Layouts.app>
