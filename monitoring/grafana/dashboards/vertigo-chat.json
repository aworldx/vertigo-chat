    {"gridPos": {"h": 5, "w": 24, "x": 0, "y": 0}, "id": 1, "options": {"code": {"language": "plaintext", "showLineNumbers": false}, "content": "## Как читать мониторинг\n\n- **Сейчас в чате** — активные сессии; **Переподключаются** — вкладки в периоде повторного соединения.\n- **RPS** — средняя интенсивность HTTP-запросов за 5 минут. **p50 / p95** — типичная и верхняя задержка: рост p95 при стабильном RPS указывает на проблему приложения, БД или внешнего сервиса.\n- **Диск** — освобождайте место до порога: алерт сработает, когда свободно менее 15%.\n- Метрики агрегированы: содержимое сообщений, IP, токены и ники не собираются.", "mode": "markdown"}, "title": "Памятка", "type": "text"},
    {"datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"}, "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "unit": "short"}, "overrides": []}, "gridPos": {"h": 7, "w": 5, "x": 0, "y": 5}, "id": 2, "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}, "targets": [{"expr": "sum(ALERTS{alertstate=\"firing\"})", "refId": "A"}], "title": "Активные алерты", "type": "stat"},
    {"datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"}, "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "gridPos": {"h": 7, "w": 5, "x": 5, "y": 5}, "id": 3, "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}, "targets": [{"expr": "sum(chat_sessions{status=\"active\"})", "refId": "A"}], "title": "Сейчас в чате", "type": "stat"},
    {"datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"}, "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "gridPos": {"h": 7, "w": 5, "x": 10, "y": 5}, "id": 4, "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}, "targets": [{"expr": "sum(chat_sessions{status=\"reconnecting\"})", "refId": "A"}], "title": "Переподключаются", "type": "stat"},
