#!/bin/sh
# An isolated database and real browser sessions; never touches production data.
set -eu
repository_root="$(CDPATH='' cd -- "$(dirname "$0")/.." && pwd)"
go_command="${GO:-go}"
maintenance="${COVERAGE_DATABASE_URL:-postgresql://localhost/postgres}"
database_name="chat_tetris_test_$$"
database_url="$(node -e 'const u=new URL(process.argv[1]);u.pathname=process.argv[2];console.log(u.href)' "$maintenance" "$database_name")"
work_dir="$(mktemp -d "${TMPDIR:-/tmp}/chat-tetris-verification.XXXXXX")"
cleanup() {
  if [ -n "${api_pid:-}" ]; then kill "$api_pid" 2>/dev/null || true; wait "$api_pid" 2>/dev/null || true; fi
  if [ -n "${created_database:-}" ]; then dropdb --maintenance-db="$maintenance" "$database_name"; fi
  rm -rf "$work_dir"
}
trap cleanup EXIT HUP INT TERM
createdb --maintenance-db="$maintenance" "$database_name"
created_database=true
psql "$database_url" -v ON_ERROR_STOP=1 -q -f "$repository_root/script/fixtures/legacy-schema.sql" > "$work_dir/schema.log"
cd "$repository_root/apps/api"
DATABASE_URL="$database_url" "$go_command" run ./cmd/migrate
GO_TETRIS_TEST_DATABASE_URL="$database_url" "$go_command" test -race ./internal/tetris/... -count=1
psql "$database_url" -v ON_ERROR_STOP=1 -q -f "$repository_root/script/fixtures/go-web.sql"
npm --prefix "$repository_root/apps/web" run build
if [ -n "${GOCOVERDIR:-}" ]; then
  "$go_command" build -buildvcs=false -cover -coverpkg=./... -o "$work_dir/api" ./cmd/api
else
  "$go_command" build -buildvcs=false -o "$work_dir/api" ./cmd/api
fi
DATABASE_URL="$database_url" API_ADDR=127.0.0.1:4067 API_PUBLIC_ORIGIN=http://127.0.0.1:4067 WEB_ASSETS_DIR="$repository_root/apps/web/dist" "$work_dir/api" > "$work_dir/api.log" 2>&1 &
api_pid=$!
attempt=0
until curl --fail --silent http://127.0.0.1:4067/health >/dev/null 2>&1; do
  attempt=$((attempt+1))
  if [ "$attempt" -ge 30 ] || ! kill -0 "$api_pid" 2>/dev/null; then cat "$work_dir/api.log" >&2; exit 1; fi
  sleep 1
done
cd "$repository_root/apps/web"
node --import=tsx browser/tetris-verification.ts http://127.0.0.1:4067
