#!/bin/sh
# Keeps generated browser DTOs in lockstep with the public OpenAPI contract.
set -eu

repository_root="$(CDPATH='' cd -- "$(dirname "$0")/.." && pwd)"
cd "$repository_root"

original_file="$(mktemp "${TMPDIR:-/tmp}/chat-contract-types.XXXXXX")"
trap 'rm -f "$original_file"' EXIT HUP INT TERM
for contract in profiles accounts chat; do
  generated_file="apps/web/src/shared/generated/$contract.ts"
  cp "$generated_file" "$original_file"
  npm --prefix apps/web run "generate:$contract-types"
  if ! cmp -s "$original_file" "$generated_file"; then
    echo "Generated $contract DTOs are stale; run npm --prefix apps/web run generate:$contract-types." >&2
    exit 1
  fi
done
