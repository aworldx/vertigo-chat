#!/bin/sh
# Tests Go auth against a disposable copy of the local legacy schema; no rows copied.
set -eu
repository_root="$(CDPATH='' cd -- "$(dirname "$0")/.." && pwd)"
go_command="${GO:-go}"
source_url="${ACCOUNTS_LEGACY_DATABASE_URL:-postgresql://localhost/chat_test}"
database_name="chat_accounts_test_$$"
database_url="$(node -e 'const u = new URL(process.argv[1]); u.pathname = process.argv[2]; console.log(u.href)' "$source_url" "$database_name")"
work_dir="$(mktemp -d "${TMPDIR:-/tmp}/chat-account-verification.XXXXXX")"
cleanup() {
  if [ -n "${api_pid:-}" ]; then kill "$api_pid" 2>/dev/null || true; wait "$api_pid" 2>/dev/null || true; fi
  if [ -n "${created_database:-}" ]; then dropdb --maintenance-db="$source_url" "$database_name"; fi
  rm -rf "$work_dir"
}
trap cleanup EXIT HUP INT TERM
createdb --maintenance-db="$source_url" "$database_name"
created_database=true
pg_dump --schema-only --no-owner --no-privileges "$source_url" > "$work_dir/schema.sql"
psql "$database_url" -v ON_ERROR_STOP=1 -q -f "$work_dir/schema.sql" > "$work_dir/schema.log"
npm --prefix "$repository_root/apps/web" run build
cd "$repository_root/apps/api"
GO_ACCOUNTS_TEST_DATABASE_URL="$database_url" "$go_command" test -race ./internal/accounts/adapters/postgres -run TestAccountsPostgres -count=1 -v
"$go_command" build -o "$work_dir/api" ./cmd/api
DATABASE_URL="$database_url" API_ADDR=127.0.0.1:4042 API_PUBLIC_ORIGIN=http://127.0.0.1:4042 WEB_ASSETS_DIR="$repository_root/apps/web/dist" "$work_dir/api" > "$work_dir/api.log" 2>&1 &
api_pid=$!
attempt=0
until curl --fail --silent http://127.0.0.1:4042/health >/dev/null 2>&1; do
  attempt=$((attempt + 1))
  if [ "$attempt" -ge 30 ] || ! kill -0 "$api_pid" 2>/dev/null; then cat "$work_dir/api.log" >&2; exit 1; fi
  sleep 1
done
cd "$repository_root/apps/web"
node --import=tsx browser/accounts-verification.ts http://127.0.0.1:4042

psql "$database_url" -v ON_ERROR_STOP=1 -q -c 'TRUNCATE registered_users, security_registration_guards RESTART IDENTITY CASCADE' > "$work_dir/reset.log" 2>&1
psql "$database_url" -v ON_ERROR_STOP=1 -q -f "$repository_root/script/fixtures/go-web.sql"
node --import=tsx browser/accounts-ui-verification.ts http://127.0.0.1:4042
