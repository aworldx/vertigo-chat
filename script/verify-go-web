#!/bin/sh
# Compare a pinned legacy checkout and standalone Go+React using isolated DBs.
set -eu
repository_root="$(CDPATH='' cd -- "$(dirname "$0")/.." && pwd)"
go_command="${GO:-go}"
verification_suite="${WEB_VERIFICATION_SUITE:-web}"
case "$verification_suite" in web|chat-feed|chat-online|chat-room|help) ;; *) echo "Unknown WEB_VERIFICATION_SUITE" >&2; exit 1 ;; esac
source_url="${ACCOUNTS_LEGACY_DATABASE_URL:-postgresql://localhost/chat_test}"
legacy_root="${LEGACY_ROOT:?Set LEGACY_ROOT to the pinned legacy checkout with built assets}"
legacy_sha="$(git -C "$legacy_root" rev-parse HEAD)"
go_port="${GO_WEB_PORT:-4043}"
legacy_port="${LEGACY_WEB_PORT:-4044}"
go_origin="http://127.0.0.1:$go_port"
legacy_origin="http://127.0.0.1:$legacy_port"
work_dir="$(mktemp -d "${TMPDIR:-/tmp}/chat-web-verification.XXXXXX")"
go_database="chat_web_go_$$"
legacy_database="chat_web_legacy_$$"
database_url() { node -e 'const u = new URL(process.argv[1]); u.pathname = process.argv[2]; console.log(u.href)' "$source_url" "$1"; }
go_url="$(database_url "$go_database")"
legacy_url="$(database_url "$legacy_database")"
cleanup() {
  for pid in "${api_pid:-}" "${legacy_pid:-}"; do
    if [ -n "$pid" ]; then kill "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true; fi
  done
  if [ -n "${go_created:-}" ]; then dropdb --maintenance-db="$source_url" "$go_database"; fi
  if [ -n "${legacy_created:-}" ]; then dropdb --maintenance-db="$source_url" "$legacy_database"; fi
  rm -rf "$work_dir"
}
trap cleanup EXIT HUP INT TERM
createdb --maintenance-db="$source_url" "$go_database"
go_created=true
createdb --maintenance-db="$source_url" "$legacy_database"
legacy_created=true
pg_dump --schema-only --no-owner --no-privileges "$source_url" > "$work_dir/schema.sql"
pg_dump --data-only --no-owner --no-privileges --table=public.schema_migrations "$source_url" >> "$work_dir/schema.sql"
for database in "$go_url" "$legacy_url"; do
  psql "$database" -v ON_ERROR_STOP=1 -q -f "$work_dir/schema.sql" > "$work_dir/schema.log"
  psql "$database" -v ON_ERROR_STOP=1 -q -f "$repository_root/script/fixtures/go-web.sql"
  if [ "$verification_suite" = chat-feed ]; then
    psql "$database" -v ON_ERROR_STOP=1 -q -f "$repository_root/script/fixtures/chat-feed.sql"
  fi
done
npm --prefix "$repository_root/apps/web" run build
cp -R "$repository_root/apps/web/dist" "$work_dir/web"
cd "$repository_root/apps/api"
DATABASE_URL="$go_url" "$go_command" run ./cmd/migrate
"$go_command" build -o "$work_dir/api" ./cmd/api
DATABASE_URL="$go_url" API_ADDR="127.0.0.1:$go_port" API_PUBLIC_ORIGIN="$go_origin" WEB_ASSETS_DIR="$work_dir/web" "$work_dir/api" > "$work_dir/go.log" 2>&1 &
api_pid=$!
cd "$legacy_root/apps/phoenix"
LEGACY_DATABASE_URL="$legacy_url" PORT="$legacy_port" mix run --no-start --no-halt -e '
config = Application.get_env(:chat, Chat.Repo) |> Keyword.drop([:database, :hostname, :username, :password]) |> Keyword.put(:url, System.fetch_env!("LEGACY_DATABASE_URL"))
Application.put_env(:chat, Chat.Repo, config)
endpoint = Application.get_env(:chat, ChatWeb.Endpoint) |> Keyword.put(:server, true) |> Keyword.put(:watchers, [])
Application.put_env(:chat, ChatWeb.Endpoint, endpoint)
Application.put_env(:chat, Chat.Karmik, enabled?: false)
Application.ensure_all_started(:chat)
' > "$work_dir/legacy.log" 2>&1 &
legacy_pid=$!
attempt=0
until curl --fail --silent "$go_origin/health" >/dev/null 2>&1 && curl --fail --silent "$legacy_origin/health" >/dev/null 2>&1; do
  attempt=$((attempt + 1))
  if [ "$attempt" -ge 60 ] || ! kill -0 "$api_pid" "$legacy_pid" 2>/dev/null; then tail -80 "$work_dir/go.log" "$work_dir/legacy.log" >&2; exit 1; fi
  sleep 1
done
printf 'legacy_sha=%s\ngo_pid=%s\nlegacy_pid=%s\ngo_database=%s\nlegacy_database=%s\n' "$legacy_sha" "$api_pid" "$legacy_pid" "$go_database" "$legacy_database" > "$work_dir/state.txt"
cd "$repository_root/apps/web"
verification_status=0
GO_ROOM_DATABASE="$go_database" LEGACY_ROOM_DATABASE="$legacy_database" LEGACY_SHA="$legacy_sha" node --import=tsx "browser/$verification_suite-verification.ts" "$go_origin" "$legacy_origin" || verification_status=$?
if [ "${KEEP_MIGRATION_STAND:-0}" = 1 ]; then
  printf 'Verification exit status: %s\n' "$verification_status"
  printf 'Local comparison: Go %s and legacy %s\nState directory: %s\nKeep this process running; Ctrl-C stops both servers and removes their disposable databases.\n' "$go_origin" "$legacy_origin" "$work_dir"
  wait "$api_pid" "$legacy_pid"
fi

exit "$verification_status"
