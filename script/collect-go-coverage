#!/bin/sh
# Real PostgreSQL coverage; every database is created and owned by this run.
set -eu
repo_root="$(CDPATH='' cd -- "$(dirname "$0")/.." && pwd)"
go_command="${GO:-go}"
maintenance="${COVERAGE_DATABASE_URL:-postgresql://localhost/postgres}"
output="$repo_root/coverage/go"
accounts_database="chat_accounts_test_coverage_$$"
application_database="chat_coverage_application_$$"
database_url() { node -e 'const u = new URL(process.argv[1]); u.pathname = process.argv[2]; console.log(u.href)' "$maintenance" "$1"; }
cleanup() {
  if [ -n "${accounts_created:-}" ]; then dropdb --maintenance-db="$maintenance" "$accounts_database"; fi
  if [ -n "${application_created:-}" ]; then dropdb --maintenance-db="$maintenance" "$application_database"; fi
}
trap cleanup EXIT HUP INT TERM
mkdir -p "$output"
createdb --maintenance-db="$maintenance" "$accounts_database"
accounts_created=true
createdb --maintenance-db="$maintenance" "$application_database"
application_created=true
accounts_url="$(database_url "$accounts_database")"
application_url="$(database_url "$application_database")"
for database in "$accounts_url" "$application_url"; do
  psql "$database" -v ON_ERROR_STOP=1 -q -f "$repo_root/script/fixtures/legacy-schema.sql" > "$output/schema.log"
done
psql "$application_url" -v ON_ERROR_STOP=1 -q -f "$repo_root/script/fixtures/go-web.sql"
cd "$repo_root/apps/api"
GO_ACCOUNTS_TEST_DATABASE_URL="$accounts_url" GO_CHAT_TEST_DATABASE_URL="$application_url" GO_COMMUNITY_TEST_DATABASE_URL="$application_url" \
  "$go_command" test -count=1 -p 4 -race -covermode=atomic -coverpkg=./... -coverprofile="$output/api-unit.cover" ./...
cd "$repo_root/services/youtube-worker"
"$go_command" test -count=1 -race -covermode=atomic -coverprofile="$output/worker.cover" ./...
