#!/bin/sh
# Compares the running Phoenix profile API with a disposable Go API over the same local data.
set -eu

repository_root="$(CDPATH='' cd -- "$(dirname "$0")/.." && pwd)"
go_command="${GO:-go}"
api_binary="$(mktemp "${TMPDIR:-/tmp}/chat-profiles-api.XXXXXX")"
api_log="$(mktemp "${TMPDIR:-/tmp}/chat-profiles-api-log.XXXXXX")"

cleanup() {
  if [ -n "${api_pid:-}" ]; then kill "$api_pid" 2>/dev/null || true; fi
  rm -f "$api_binary" "$api_log"
}
trap cleanup EXIT HUP INT TERM

cd "$repository_root/apps/api"
"$go_command" build -o "$api_binary" ./cmd/api
DATABASE_URL="${DATABASE_URL:?Set DATABASE_URL for the disposable Go API}" API_ADDR="127.0.0.1:4020" "$api_binary" >"$api_log" 2>&1 &
api_pid=$!

attempt=0
until curl --fail --silent --show-error http://127.0.0.1:4020/health >/dev/null 2>&1; do
  attempt=$((attempt + 1))
  if [ "$attempt" -ge 30 ]; then
    cat "$api_log" >&2
    exit 1
  fi
  sleep 1
done

cd "$repository_root"
node script/compare-profile-contracts.mjs
