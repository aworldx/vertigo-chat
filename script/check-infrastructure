#!/bin/sh
# Containerized, pinned linters keep local and CI infrastructure checks identical.
set -eu

repository_root="$(CDPATH='' cd -- "$(dirname "$0")/.." && pwd)"
cd "$repository_root"

if ! command -v docker >/dev/null 2>&1; then
  echo "Docker is required for infrastructure quality checks." >&2
  exit 1
fi

shell_files="$(find script -maxdepth 1 -type f ! -name '*.exs' -print | sort)"
# shellcheck disable=SC2086 # Files are repository-controlled and contain no whitespace.
docker run --rm -v "$repository_root:/work:ro" -w /work koalaman/shellcheck:v0.10.0 $shell_files
docker run --rm -i -v "$repository_root:/work:ro" -w /work hadolint/hadolint:v2.12.0 hadolint --config /work/.hadolint.yaml - < Dockerfile
docker run --rm -v "$repository_root:/work:ro" -w /work redocly/cli:1.34.5 lint docs/openapi/profiles.yaml

docker compose --env-file config/quality.env config --quiet
