#!/usr/bin/env bash
# Назначение файла: разворачивает на production VPS готовый linux/amd64-образ,
# опубликованный GitLab CI в Container Registry. На VPS сборка не выполняется.
set -euo pipefail

project_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
remote_host="${CHAT_DEPLOY_HOST:-root@109.248.170.47}"
remote_dir="${CHAT_DEPLOY_DIR:-/opt/apps/vertigo-chat}"
image_repository="${CHAT_IMAGE:-registry.gitlab.com/aworldx1/vertigo-chat}"
deploy_target="${1:-all}"

case "$deploy_target" in
  all|app|admin|youtube-worker) ;;
  *)
    echo "Usage: $0 [all|app|admin|youtube-worker]" >&2
    exit 2
    ;;
esac

cd "$project_dir"

if [[ -n "$(git status --porcelain)" ]]; then
  echo "Working tree must be clean before production deployment." >&2
  exit 1
fi

git fetch origin main
local_revision="$(git rev-parse HEAD)"
remote_revision="$(git rev-parse origin/main)"

if [[ "$local_revision" != "$remote_revision" ]]; then
  echo "HEAD must match origin/main before production deployment." >&2
  exit 1
fi

ssh "$remote_host" bash -s -- "$remote_dir" "$local_revision" "$image_repository" "$deploy_target" <<'REMOTE'
set -euo pipefail

deploy_dir="$1"
expected_revision="$2"
image_repository="$3"
deploy_target="$4"
registry_host="${CHAT_REGISTRY_HOST:-registry.gitlab.com}"

env_value() {
  local key="$1"
  sed -n "s/^${key}=//p" .env | tail -n 1
}

cd "$deploy_dir"
test -z "$(git status --porcelain)"
git pull --ff-only origin main
test "$(git rev-parse HEAD)" = "$expected_revision"

registry_username="$(env_value GITLAB_REGISTRY_USERNAME)"
registry_token="$(env_value GITLAB_REGISTRY_TOKEN)"

if [[ -n "$registry_token" ]]; then
  if [[ -z "$registry_username" ]]; then
    echo "GITLAB_REGISTRY_USERNAME must be set with GITLAB_REGISTRY_TOKEN." >&2
    exit 1
  fi

  printf '%s' "$registry_token" | docker login "$registry_host" --username "$registry_username" --password-stdin
  unset registry_token
else
  echo "No GitLab Registry token configured; attempting an anonymous image pull."
fi

mkdir -p logs
chown 65534:root logs
chmod 0770 logs

export CHAT_IMAGE_TAG="$expected_revision"
export CHAT_APP_IMAGE="${image_repository}-app"
export CHAT_ADMIN_IMAGE="${image_repository}-admin"
export CHAT_YOUTUBE_WORKER_IMAGE="${image_repository}-youtube-worker"

compose() {
  docker compose --env-file .env --env-file .env.vps "$@"
}

wait_for_health() {
  local service="$1"
  local container_id status

  container_id="$(compose ps -q "$service")"
  if [[ -z "$container_id" ]]; then
    echo "Container for $service was not created." >&2
    return 1
  fi

  for _attempt in $(seq 1 30); do
    status="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$container_id")"
    if [[ "$status" == "healthy" || "$status" == "running" ]]; then
      return 0
    fi

    sleep 2
  done

  echo "$service did not become healthy." >&2
  compose logs --tail 100 "$service" >&2
  return 1
}

case "$deploy_target" in
  all)
    compose pull migrate app admin youtube-cache-init youtube-worker caddy
    compose run --rm --no-deps migrate
    compose run --rm --no-deps youtube-cache-init
    compose up -d --no-build --force-recreate --no-deps app admin youtube-worker caddy
    wait_for_health app
    wait_for_health admin
    wait_for_health youtube-worker
    curl --fail --silent --show-error http://127.0.0.1/ >/dev/null
    ;;
  app)
    compose pull migrate app
    compose run --rm --no-deps migrate
    compose up -d --no-build --force-recreate --no-deps app
    wait_for_health app
    curl --fail --silent --show-error http://127.0.0.1/ >/dev/null
    ;;
  admin)
    compose pull admin
    compose up -d --no-build --force-recreate --no-deps admin
    wait_for_health admin
    ;;
  youtube-worker)
    compose pull youtube-cache-init youtube-worker
    compose run --rm --no-deps youtube-cache-init
    compose up -d --no-build --force-recreate --no-deps youtube-worker
    wait_for_health youtube-worker
    ;;
esac

compose ps
REMOTE
