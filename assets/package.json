{
  "name": "vertigo-web",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import=tsx --test test/*.test.tsx",
    "typecheck": "tsc --noEmit",
    "lint": "eslint js/profiles.tsx js/profiles test",
    "format:check": "prettier --check js/profiles.tsx js/profiles test package.json tsconfig.json eslint.config.js",
    "generate:profiles-types": "openapi-typescript ../docs/openapi/profiles.yaml -o js/shared/generated/profiles.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
