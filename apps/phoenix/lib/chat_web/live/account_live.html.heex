<Layouts.app flash={@flash} current_account_user={@current_account_user} return_to={~p"/account"}>
  <section
    id="account-settings-page"
    class="min-h-screen bg-zinc-950 px-4 py-10 text-zinc-100 sm:px-8"
  >
    <div class="mx-auto w-full max-w-xl rounded-2xl border border-zinc-800 bg-zinc-900 p-6 shadow-xl sm:p-8">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-rose-300">Аккаунт</p>
      <h1 class="mt-2 text-3xl font-semibold">Email для форума</h1>
      <p class="mt-3 text-sm leading-6 text-zinc-400">
        Другие пользователи не увидят этот адрес. Он нужен только для входа на форум,
        уведомлений и восстановления доступа.
      </p>

      <.form
        for={@email_form}
        id="forum-email-form"
        phx-submit="save_forum_email"
        class="mt-6 space-y-4"
      >
        <.input
          field={@email_form[:email]}
          id="forum-email"
          type="email"
          label="Email"
          autocomplete="email"
          maxlength="254"
          placeholder="you@example.com"
        />
        <button
          id="save-forum-email"
          type="submit"
          phx-disable-with="Сохраняем…"
          class="rounded-lg bg-amber-300 px-4 py-2 text-sm font-semibold text-zinc-950 transition hover:bg-amber-200"
        >
          Сохранить email
        </button>
      </.form>
    </div>
  </section>
</Layouts.app>
