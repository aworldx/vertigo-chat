<Layouts.app flash={@flash}>
  <main id="admin-page" class="min-h-dvh bg-[#101612] px-4 py-6 text-stone-100 sm:px-8">
    <div class="mx-auto grid max-w-7xl gap-6 lg:grid-cols-[15rem_minmax(0,1fr)]">
      <aside class="rounded-2xl border border-emerald-950 bg-[#162019] p-5 shadow-2xl shadow-black/20">
        <div class="border-b border-emerald-950 pb-5">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-amber-300">Vertigo</p>
          <h1 class="mt-1 text-2xl font-semibold text-white">Админка</h1>
          <p id="admin-chat-version" class="mt-2 text-sm text-emerald-200/70">
            Версия {@chat_version}
          </p>
        </div>
        <nav
          :if={@current_user}
          aria-label="Разделы админки"
          class="mt-5 space-y-1 text-sm"
        >
          <a
            :if={@is_admin?}
            href={~p"/admin?section=database"}
            class={[
              "block rounded-lg px-3 py-2 font-medium",
              if(@selected_section == :database,
                do: "bg-emerald-900/50 text-emerald-100",
                else: "text-stone-300 hover:bg-emerald-950 hover:text-white"
              )
            ]}
          >Данные</a>
          <a
            href={~p"/admin?section=emojis"}
            class={[
              "block rounded-lg px-3 py-2 transition",
              if(@selected_section == :emojis,
                do: "bg-emerald-900/50 font-medium text-emerald-100",
                else: "text-stone-300 hover:bg-emerald-950 hover:text-white"
              )
            ]}
          >Смайлы</a>
          <a
            href={~p"/admin?section=tags"}
            class={[
              "block rounded-lg px-3 py-2 transition",
              if(@selected_section == :tags,
                do: "bg-emerald-900/50 font-medium text-emerald-100",
                else: "text-stone-300 hover:bg-emerald-950 hover:text-white"
              )
            ]}
          >Теги</a>
        </nav>
      </aside>

      <div class="min-w-0 space-y-6">
        <section
          :if={is_nil(@current_user)}
          id="admin-login-required"
          class="mx-auto max-w-md rounded-2xl border border-emerald-900 bg-[#162019] p-6 shadow-xl shadow-black/20"
        >
          <p class="text-sm text-amber-300">Закрытая зона</p>
          <h2 class="mt-1 text-2xl font-semibold text-white">Вход в админку</h2>
          <p class="mt-2 text-sm leading-5 text-zinc-400">
            Доступ есть у администраторов и модераторов смайлов.
          </p>
          <form
            action={~p"/admin/login"}
            method="post"
            id="admin-login-form"
            class="mt-6 space-y-4"
          >
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <.input
              id="admin-login-nickname"
              name="admin_auth[nickname]"
              value=""
              label="Ник"
              required
            />
            <.input
              id="admin-login-password"
              name="admin_auth[password]"
              value=""
              type="password"
              label="Пароль"
              required
            />
            <button
              id="admin-login-submit"
              class="w-full rounded-lg bg-amber-300 px-4 py-2.5 font-semibold text-stone-950 transition hover:bg-amber-200"
            >Войти</button>
          </form>
        </section>

        <section
          :if={@current_user && @is_admin? && @selected_section == :database}
          id="database"
          class="rounded-2xl border border-emerald-950 bg-[#162019] p-5 shadow-xl shadow-black/20 sm:p-6"
        >
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <p class="text-sm font-medium text-amber-300">База данных</p>
              <h2 class="mt-1 text-2xl font-semibold text-white">Просмотр таблиц</h2>
              <p class="mt-1 text-sm text-stone-400">
                Только чтение; отображаются первые 100 строк выбранной таблицы.
              </p>
            </div>
            <span class="rounded-full border border-emerald-800 px-3 py-1 text-xs text-emerald-200">{@current_user.nickname}</span>
          </div>

          <div id="admin-table-list" class="mt-5 flex flex-wrap gap-2">
            <a
              :for={table <- @database.tables}
              href={~p"/admin?#{[table: table]}"}
              class={[
                "rounded-lg border px-3 py-1.5 text-sm transition",
                if(table == @database.selected_table,
                  do: "border-amber-300 bg-amber-300 text-stone-950",
                  else: "border-emerald-900 text-emerald-100 hover:border-emerald-600"
                )
              ]}
            >{table}</a>
          </div>

          <div class="mt-6 overflow-x-auto rounded-xl border border-emerald-950">
            <table
              :if={@database.selected_table}
              id="admin-database-table"
              class="min-w-full divide-y divide-emerald-950 text-left text-sm"
            >
              <caption class="bg-[#111a14] px-4 py-3 text-left font-medium text-stone-200">
                {@database.selected_table}
              </caption>
              <thead class="bg-emerald-950/40 text-xs uppercase tracking-wide text-emerald-200">
                <tr>
                  <th
                    :for={column <- @database.columns}
                    class="whitespace-nowrap px-4 py-3 font-medium"
                  >
                    {column}
                  </th>
                </tr>
              </thead>
              <tbody class="divide-y divide-emerald-950/70 text-stone-300">
                <tr :for={row <- @database.rows}>
                  <td :for={value <- row} class="max-w-xs px-4 py-3 align-top break-words">
                    {admin_value(value)}
                  </td>
                </tr>
                <tr :if={@database.rows == []}>
                  <td
                    colspan={max(length(@database.columns), 1)}
                    class="px-4 py-8 text-center text-stone-500"
                  >
                    В таблице пока нет строк.
                  </td>
                </tr>
              </tbody>
            </table>
            <p
              :if={is_nil(@database.selected_table)}
              id="admin-database-empty"
              class="px-4 py-8 text-center text-stone-500"
            >
              Таблицы не найдены.
            </p>
          </div>
        </section>

        <section
          :if={@current_user && @selected_section == :emojis}
          id="emojis"
          class="rounded-2xl border border-emerald-950 bg-[#162019] p-5 shadow-xl shadow-black/20 sm:p-6"
        >
          <p class="text-sm font-medium text-amber-300">Контент</p><h2 class="mt-1 text-2xl font-semibold text-white">
            Смайлы
          </h2>
          <form
            action={~p"/admin/emojis"}
            method="post"
            enctype="multipart/form-data"
            id="admin-emoji-form"
            class="mt-5 grid gap-4 sm:grid-cols-[1fr_1fr_auto] sm:items-end"
          >
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <.input
              id="emoji-code"
              name="emoji[code]"
              value=""
              label="Код без двоеточий"
              placeholder="гляжу_кота"
              required
            />
            <.input
              id="emoji-image"
              name="emoji[image]"
              value=""
              type="file"
              accept="image/png,image/webp,image/gif"
              label="PNG, WebP или GIF до 700 КБ, 100×100 px"
              required
            />
            <button
              id="admin-emoji-submit"
              class="rounded-lg bg-amber-300 px-4 py-2.5 font-semibold text-stone-950 transition hover:bg-amber-200"
            >Добавить</button>
          </form>
          <p class="mt-3 text-sm text-stone-400">
            До 700 КБ и 100×100 px. Введите код без двоеточий: <code>кот_плачет</code>. В сообщениях он будет выглядеть как <code>:кот_плачет:</code>.
          </p>
          <div id="admin-emojis-list" class="mt-5 space-y-6">
            <% sections = [
              {"pending", "На модерации", @emoji_groups.pending},
              {"approved", "Одобренные", @emoji_groups.approved},
              {"rejected", "Отклонённые", @emoji_groups.rejected}
            ] %>
            <section
              :for={{status, title, emojis} <- sections}
              :if={emojis != []}
              id={"admin-emojis-#{status}"}
            >
              <h3 class="mb-3 text-sm font-semibold uppercase tracking-wide text-stone-400">
                {title}
              </h3>
              <div
                id={"admin-emojis-#{status}-grid"}
                class="grid grid-cols-[repeat(auto-fill,minmax(5rem,1fr))] gap-3 sm:grid-cols-[repeat(auto-fill,minmax(6rem,1fr))]"
              >
                <a
                  :for={emoji <- emojis}
                  id={"admin-emoji-#{emoji.id}"}
                  href={~p"/admin?section=emojis&emoji_id=#{emoji.id}"}
                  aria-current={@selected_emoji && @selected_emoji.id == emoji.id && "true"}
                  class={[
                    "group flex aspect-square flex-col items-center justify-center gap-2 rounded-xl border bg-[#111a14] p-2 text-center transition hover:border-amber-300 hover:bg-amber-300/10",
                    @selected_emoji && @selected_emoji.id == emoji.id &&
                      "border-amber-300 ring-2 ring-amber-300/30",
                    (!@selected_emoji || @selected_emoji.id != emoji.id) && "border-emerald-950"
                  ]}
                >
                  <img
                    src={~p"/emojis/#{emoji.id}"}
                    alt={emoji.code}
                    width={emoji.width}
                    height={emoji.height}
                    class="h-auto w-auto max-h-12 max-w-12 object-contain"
                  />
                  <span class="w-full truncate text-xs text-stone-300">{String.trim(
                    emoji.code,
                    ":"
                  )}</span>
                </a>
              </div>
            </section>
          </div>

          <p :if={@emojis == []} class="mt-5 text-sm text-stone-500">Смайлов пока нет.</p>

          <div
            :if={@selected_emoji}
            id="admin-emoji-editor-modal"
            role="dialog"
            aria-modal="true"
            aria-labelledby="admin-emoji-editor-title"
            class="fixed inset-0 z-50 flex items-center justify-center bg-zinc-950/80 p-4 backdrop-blur-sm"
          >
            <a
              id="close-emoji-editor-backdrop"
              href={~p"/admin?section=emojis"}
              aria-label="Закрыть редактор смайла"
              class="absolute inset-0"
            ></a>
            <form
              id={"admin-emoji-editor-#{@selected_emoji.id}"}
              action={~p"/admin/emojis/#{@selected_emoji.id}"}
              method="post"
              class="relative z-10 flex max-h-[90vh] w-full max-w-xl flex-col gap-4 overflow-y-auto rounded-xl border border-amber-300/40 bg-[#111a14] p-5 shadow-2xl"
            >
              <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
              <div class="flex items-center justify-between gap-4">
                <h3 id="admin-emoji-editor-title" class="text-lg font-semibold text-white">
                  Редактирование смайла
                </h3>
                <a
                  id="close-emoji-editor"
                  href={~p"/admin?section=emojis"}
                  class="rounded px-3 py-2 text-sm text-stone-300 transition hover:bg-emerald-950 hover:text-white"
                >Закрыть</a>
              </div>
              <img
                src={~p"/emojis/#{@selected_emoji.id}"}
                alt={@selected_emoji.code}
                width={@selected_emoji.width}
                height={@selected_emoji.height}
                class="h-auto w-auto max-h-24 max-w-24 self-center object-contain"
              />
              <div>
                <.input
                  id={"emoji-code-#{@selected_emoji.id}"}
                  name="emoji[code]"
                  value={String.trim(@selected_emoji.code, ":")}
                  label="Код смайла без двоеточий"
                  placeholder="танцую"
                  required
                />
                <p class="mt-2 text-xs text-stone-500">
                  {@selected_emoji.width}×{@selected_emoji.height} · {@selected_emoji.content_type}{if @selected_emoji.animated,
                    do: " · анимация"}{if @selected_emoji.user,
                    do: " · " <> @selected_emoji.user.nickname}
                </p>
              </div>
              <div>
                <details
                  id={"emoji-tags-#{@selected_emoji.id}"}
                  class="group rounded-lg border border-emerald-900 bg-[#162019]"
                >
                  <summary class="cursor-pointer list-none px-3 py-2 text-sm text-stone-200 marker:hidden">
                    <span class="flex items-center justify-between gap-2">
                      <span class="font-medium">Теги</span>
                      <span class="truncate text-xs text-stone-400">
                        {if @selected_emoji.emoji_tags == [],
                          do: "не выбраны",
                          else: Enum.map_join(@selected_emoji.emoji_tags, ", ", & &1.name)}
                      </span>
                    </span>
                  </summary>
                  <div class="max-h-44 overflow-y-auto border-t border-emerald-950 p-2">
                    <label
                      :for={tag <- @emoji_tags}
                      for={"emoji-#{@selected_emoji.id}-tag-#{tag.id}"}
                      class="flex cursor-pointer items-center gap-2 rounded px-2 py-1.5 text-sm text-stone-300 hover:bg-emerald-950"
                    >
                      <input
                        id={"emoji-#{@selected_emoji.id}-tag-#{tag.id}"}
                        name="emoji[tag_ids][]"
                        type="checkbox"
                        value={tag.id}
                        checked={Enum.any?(@selected_emoji.emoji_tags, &(&1.id == tag.id))}
                        class="size-4 rounded border-emerald-700 bg-[#101612] text-amber-300 focus:ring-amber-300"
                      />
                      {tag.name}
                    </label>
                    <p :if={@emoji_tags == []} class="px-2 py-1 text-sm text-stone-500">
                      Сначала добавьте теги в разделе «Теги».
                    </p>
                  </div>
                </details>
              </div>
              <div class="space-y-2">
                <label
                  for={"emoji-status-#{@selected_emoji.id}"}
                  class="block text-sm font-medium text-zinc-200"
                >Статус</label>
                <select
                  id={"emoji-status-#{@selected_emoji.id}"}
                  name="emoji[status]"
                  class="block w-full rounded border border-emerald-900 bg-[#162019] px-3 py-2.5 text-sm text-stone-100"
                ><option
                  :for={status <- ~w(pending approved rejected)}
                  value={status}
                  selected={to_string(@selected_emoji.status) == status}
                >
                  {status}
                </option></select>
              </div>
              <div :if={@selected_emoji.status == :rejected}>
                <.input
                  id={"emoji-rejection-#{@selected_emoji.id}"}
                  name="emoji[rejection_reason]"
                  value={@selected_emoji.rejection_reason || ""}
                  label="Причина отклонения"
                />
              </div>
              <div class="flex flex-wrap items-center justify-end gap-2 border-t border-emerald-950 pt-4">
                <button
                  type="submit"
                  formmethod="post"
                  formaction={~p"/admin/emojis/#{@selected_emoji.id}"}
                  name="_method"
                  value="delete"
                  class="whitespace-nowrap rounded border border-red-400/50 px-4 py-2.5 text-sm font-semibold text-red-200 hover:bg-red-400/10"
                >Удалить</button>
                <button
                  type="submit"
                  class="whitespace-nowrap rounded bg-amber-300 px-4 py-2.5 text-sm font-semibold text-stone-950 hover:bg-amber-200"
                >Сохранить</button>
              </div>
            </form>
          </div>
        </section>
        <section
          :if={@current_user && @selected_section == :tags}
          id="emoji-tags"
          class="rounded-2xl border border-emerald-950 bg-[#162019] p-5 shadow-xl shadow-black/20 sm:p-6"
        >
          <p class="text-sm font-medium text-amber-300">Справочник</p>
          <h2 class="mt-1 text-2xl font-semibold text-white">Теги смайлов</h2>
          <form
            action={~p"/admin/emoji-tags"}
            method="post"
            id="admin-emoji-tag-form"
            class="mt-5 grid max-w-3xl gap-4 sm:grid-cols-[12rem_minmax(0,1fr)_auto] sm:items-end"
          >
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <.input
              id="emoji-tag-name"
              name="emoji_tag[name]"
              value=""
              label="Новый тег"
              placeholder="грусть"
              required
            />
            <.input
              id="emoji-tag-triggers"
              name="emoji_tag[triggers]"
              value=""
              type="textarea"
              rows="3"
              label="Триггеры — необязательно"
              placeholder="По одному на строку: печаль, грустно, 😢"
            />
            <button
              type="submit"
              class="shrink-0 rounded-lg bg-amber-300 px-4 py-2.5 font-semibold text-stone-950 hover:bg-amber-200"
            >Добавить</button>
          </form>
          <p class="mt-3 max-w-3xl text-sm text-stone-400">
            Тег и его триггеры используются для автоподбора. Триггером может быть слово, эмодзи или целая фраза; указывайте по одному на строку.
          </p>
          <div id="admin-emoji-tags-list" class="mt-6 grid gap-3 sm:grid-cols-2">
            <details
              :for={tag <- @emoji_tags}
              id={"admin-emoji-tag-#{tag.id}"}
              class="group rounded-lg border border-emerald-950 bg-[#111a14] text-sm text-stone-200"
            >
              <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-3 py-3 marker:hidden hover:bg-emerald-950/40">
                <span class="min-w-0">
                  <span class="font-medium text-stone-100">{tag.name}</span>
                  <span :if={tag.triggers != []} class="ml-2 text-xs text-stone-500">
                    {Enum.take(tag.triggers, 3) |> Enum.join(" · ")}
                  </span>
                </span>
                <span class="shrink-0 text-xs text-stone-400">
                  {length(tag.triggers)} триггеров · изменить
                </span>
              </summary>
              <div class="border-t border-emerald-950 p-3">
                <form
                  action={~p"/admin/emoji-tags/#{tag.id}"}
                  method="post"
                  id={"edit-emoji-tag-#{tag.id}"}
                  class="grid gap-3"
                >
                  <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                  <.input
                    id={"emoji-tag-name-#{tag.id}"}
                    name="emoji_tag[name]"
                    value={tag.name}
                    label="Тег"
                    required
                  />
                  <.input
                    id={"emoji-tag-triggers-#{tag.id}"}
                    name="emoji_tag[triggers]"
                    value={Enum.join(tag.triggers, "\n")}
                    type="textarea"
                    rows="4"
                    label="Триггеры — по одному на строку"
                    placeholder="Например: печаль, грустно, 😢"
                  />
                  <button
                    type="submit"
                    class="justify-self-start rounded bg-amber-300 px-3 py-2 text-xs font-semibold text-stone-950 hover:bg-amber-200"
                  >Сохранить</button>
                </form>
                <.form
                  for={to_form(%{}, as: :tag)}
                  action={~p"/admin/emoji-tags/#{tag.id}"}
                  method="delete"
                  class="mt-3"
                >
                  <button
                    id={"delete-emoji-tag-#{tag.id}"}
                    type="submit"
                    class="text-xs text-red-300 hover:text-red-200"
                  >Удалить тег</button>
                </.form>
              </div>
            </details>
          </div>
        </section>
      </div>
    </div>
  </main>
</Layouts.app>
