{
  "name": "vertigo-web",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import=tsx --test test/*.test.tsx",
    "test:browser": "playwright test",
    "browsers:install": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src js/profiles.tsx js/account_login.tsx test browser playwright.config.ts && node scripts/check-architecture.mjs",
    "format:check": "prettier --check src js/profiles.tsx js/account_login.tsx test browser playwright.config.ts package.json tsconfig.json eslint.config.js",
    "generate:profiles-types": "openapi-typescript ../../contracts/openapi/profiles.yaml -o src/shared/generated/profiles.ts",
    "generate:accounts-types": "openapi-typescript ../../contracts/openapi/accounts.yaml -o src/shared/generated/accounts.ts",
    "build": "node scripts/build.mjs",
    "generate:chat-types": "openapi-typescript ../../contracts/openapi/chat.yaml -o src/shared/generated/chat.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.57.0",
    "@tailwindcss/cli": "4.3.0",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.2",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.25.4",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
